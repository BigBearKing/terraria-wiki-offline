<Project Sdk="Microsoft.NET.Sdk.Razor">

	<!-- 本机可选的 TFM 覆盖（不进版本库）：存在 Local.props 时只构建它指定的 TFM。
	     这台机器只做 iOS / Mac Catalyst，避免 Rider 同时分析 Android 时因缺少
	     Android SDK 产生大量假错误。CI / 其他机器没有这个文件，仍按完整 TFM 构建。 -->
	<Import Project="Local.props" Condition="Exists('Local.props')" />

	<PropertyGroup>
		<!-- .NET 11 起 MAUI 包按带平台版本的 TFM 打包（如 net11.0-android37.0），
		     因此这里必须显式写出平台版本，否则 NuGet 会报 NU1012。
		     版本号需与**已安装工作负载**一致。RC.2 的工作负载版本：
		       android      37.2.0-rc.2.84  → 包名仍是 Microsoft.Android.Ref.37，TFM 用 android37.0
		       ios          27.0.12212-net11-rc.2 → 只有 27.0 的包，TFM 必须写 ios27.0
		       maccatalyst  27.0.12212-net11-rc.2 → 同上，TFM 必须写 maccatalyst27.0
		     ★ 换工作负载版本时必须回到这里核对：TFM 的版本号对不上会直接构建失败。 -->
		<TargetFrameworks Condition="'$(TerrariaLocalFramework)' == ''">net11.0-android37.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(TerrariaLocalFramework)' == '' and !$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios27.0;net11.0-maccatalyst27.0</TargetFrameworks>
		<TargetFrameworks Condition="'$(TerrariaLocalFramework)' != ''">$(TerrariaLocalFramework)</TargetFrameworks>
		<TargetFrameworks Condition="'$(TerrariaLocalFramework)' == '' and $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
		<SupportedCultures>zh-CN;en-US</SupportedCultures>
		<NeutralLanguage>en-US</NeutralLanguage>
		<!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>Terraria_Wiki</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCssItems>false</EnableDefaultCssItems>
		<Nullable>enable</Nullable>
		<!-- 源生成 COM 互操作（[GeneratedComInterface]，见 WindowHelper 的 ITaskbarList）要求打开它：
		     SYSLIB1062 —— 生成出来的 vtable 编组代码本身是 unsafe 的。
		     NativeAOT 不支持内置 COM（IL3052），任务栏按钮增删只能走这条路。 -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS4014;CS0618</NoWarn>
		<SelfContained>true</SelfContained>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
		<!-- Enable XAML source generation for faster build times and improved performance.
             This generates C# code from XAML at compile time instead of runtime inflation.
             To disable, remove this line.
             For individual files, you can override by setting Inflator metadata:
               <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
               <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Terraria Wiki</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.bigbearking.terrariawiki</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.4.0</ApplicationDisplayVersion>
		<ApplicationVersion>4</ApplicationVersion>
		<PackageVersion>0.4.0</PackageVersion>
		<Company>BigBearKingdom</Company>

		<Authors>BigBearKing</Authors>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- ★ 最低部署版本必须 ≥ SDK 声明的下限，否则构建直接报错。RC.2 的下限来自：
		       Microsoft.iOS.Sdk.SupportedTargetPlatforms.props     → iOSMinSupportedOSPlatformVersion = 15.0
		       Microsoft.MacCatalyst.Sdk.SupportedTargetPlatforms.props → MacCatalystMinSupportedOSPlatformVersion = 17.0
		     ★ 这两个值同时是"支持的设备/系统下限"这个产品口径，不是纯技术参数：
		       iOS 15.0 → 16.4、macCatalyst 17.0（macOS 14）→ 18.0（macOS 15）会**缩小可安装范围**。
		       若哪天要重新支持更低的系统，只能退回到旧工作负载（SDK/TFM 一起退），不能只改这里。
		     ★ 现在取 iOS 16.4 / macOS 15（Catalyst 18.0）：Catalyst 的窗口、全屏、安全区行为
		       在 macOS 15 及以上才与当前 SDK 对齐，更低系统上表现不可控。 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.4</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">18.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<DefaultLanguage>zh-cn</DefaultLanguage>
	</PropertyGroup>

	<!-- ★★ Mac Catalyst 的 .app 包名必须钉回程序集名，否则 Rider 点"运行"会报文件不存在。
	     背景：.NET 10 起，桌面 SDK（SdkIsDesktop=true，即 macOS / Mac Catalyst）在
	     Xamarin.Shared.props 里把 _AppBundleName 默认成 $(ApplicationTitle)：
	         <_AppBundleName Condition="... VersionGreaterThanOrEquals(TargetFrameworkVersion, 10.0) And SdkIsDesktop">$(ApplicationTitle)</_AppBundleName>
	     于是产物是 "Terraria Wiki.app"，而 Rider 的 Mac Catalyst 运行配置按
	     $(AssemblyName).app 拼路径（bin/.../maccatalyst-arm64/Terraria_Wiki.app/Contents/MacOS/Terraria_Wiki），
	     点运行就直接报"文件不存在"——构建本身是成功的。
	     iOS 不走这条桌面 SDK 分支（SdkIsDesktop=false），包名本来就是程序集名，所以 iOS 没这问题。
	     这里只覆盖包目录名；显示名仍来自 ApplicationTitle → CFBundleDisplayName（"Terraria Wiki"）。 -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<_AppBundleName>$(AssemblyName)</_AppBundleName>
	</PropertyGroup>

	<!-- ★★ 只在「还原」时声明 iOS 的 RID 列表，避免 NETSDK1112。
	     背景：.NET 11 起 iOS 默认跑 CoreCLR，运行时包是
	       Microsoft.NETCore.App.Runtime.ios-arm64 / .iossimulator-arm64
	     （不是工作负载 packs 里自带的 Mono 包），必须由 NuGet 还原下载。而还原**只为当前 RID
	     下载运行时包**：不带 -r 时 iOS 的默认 RID 是 iossimulator-arm64，只拿到模拟器包；
	     Rider 的还原正是这种（资产文件里已经有了 ios-arm64 目标，但没有对应运行时包），
	     随后用 -p:RuntimeIdentifier=ios-arm64 构建（Rider 的真机运行配置、CI 都是这样）→ NETSDK1112「未下载 Microsoft.NETCore.App.Runtime.ios-arm64 的运行时包」。
	     所以还原时把两个 RID 都报上去，让两份包一起进全局缓存。

	     ★ 为什么必须限定在还原阶段（ExcludeRestorePackageImports=true 是 NuGet 还原图形
	       求值时的全局属性）：iOS SDK 在 Xamarin.Shared.Sdk.props 里这样判定模拟器：
	           _SdkIsSimulator = RuntimeIdentifier.Contains('simulator')
	                          Or RuntimeIdentifiers.Contains('simulator')
	       因此只要项目里**常驻** RuntimeIdentifiers=ios-arm64;iossimulator-arm64，
	       真机构建（-p:RuntimeIdentifier=ios-arm64）也会被判成模拟器，随后
	       _ValidateRuntimeIdentifier 报 "RuntimeIdentifier was changed too late"。
	       只在还原时声明，构建阶段仍保持"单 RID"语义，真机/模拟器构建都不受影响。
	     ★ 还原时附带 RuntimeIdentifier 的命令（CI 的 -p:RuntimeIdentifier=ios-arm64）不受影响：
	       那种情况下 SDK 自己就会下载设备包，这里再加会重复。 -->
	<PropertyGroup Condition="'$(ExcludeRestorePackageImports)' == 'true' And '$(RuntimeIdentifier)' == '' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<RuntimeIdentifiers>ios-arm64;iossimulator-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(Configuration)' == 'Release'">
		<PublishAot>true</PublishAot>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- ReadyToRun 与 NativeAOT 互斥：WindowsAppSDK / WinUI 会默认把
		     PublishReadyToRun 设为 true，导致 AOT 静默退化为自包含 JIT 包。 -->
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>

	<!-- ★★ 打开反射式 JSON 序列化（AOT 下 BlazorWebView 的硬需求）
	     2026-10-02：AOT 包界面"一直 loading"的根因。
	     Microsoft.AspNetCore.Components.WebView 的 IpcCommon.Serialize 用反射式
	     JsonSerializer 序列化 IPC 消息（AttachPage / OnRenderCompleted 用的就是这条路径）。
	     NativeAOT 默认关闭反射序列化 → 该调用抛
	     "Reflection-based serialization has been disabled for this application."
	     异常发生在框架内部，被 IpcSender 自己吞掉 → 前端收不到渲染结果 →
	     DOM 的 #app 永远为空，界面停在 loading，且任何日志里都看不到错误。

	     JsonSerializerIsReflectionEnabledByDefault=true 是 .NET 官方为此场景留的开关，
	     会在 ILC 编译期保留反射序列化所需的元数据。
	     代价是包体略增（实测 exe 35MB → 38MB），远小于"打不开"的代价。 -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(Configuration)' == 'Release'">
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<ItemGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(Configuration)' == 'Release'">
		<RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault"
		                                Value="true" Trim="false" />
	</ItemGroup>

	<!-- 已移除：RC.1 时代为绕开"Android 工作负载把 MicrosoftNETCoreAppRefPackageVersion
	     钉成 nuget 上不存在的版本 → NU1102 → MSBuild 静默回退 R2R → publish 仍 EXIT=0
	     但产出非原生包"而加的覆盖。
	     2026-10 实测：RC.2 的 Microsoft.Android.Sdk.Windows/37.2.0-rc.2.84 的
	     BundledVersions.targets 里已不再钉这个属性，缺陷已修，故删除该覆盖。
	     ★ 若将来又在 publish 见到"无 ILC 日志 / 产出 300MB 级非原生包"，先查这个属性。 -->

	<PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
		<ApplicationIcon>Resources\AppIcon\appicon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="ApplicationBuildNumber" Value="$(ApplicationVersion)" />
	</ItemGroup>

	<!-- 下面三段的条件原本写的是 net11.0-ios26.5；RC.2 起 iOS TFM 是 ios27.0，
	     条件对不上就等于失效（ProvisioningType / CodesignKey 不会生效）。 -->
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0-ios27.0|AnyCPU'" />

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0-ios27.0|AnyCPU'" />

	<PropertyGroup Condition="'$(TargetFramework)'=='net11.0-ios27.0'">
	  <ProvisioningType>automatic</ProvisioningType>
	  <CodesignKey>iPhone Developer</CodesignKey>
	</PropertyGroup>


	<ItemGroup>
		<ScopedCss Include="Components\**\*.razor.css" />
	</ItemGroup>

	<ItemGroup>
		<!-- Legal notices: package them as MAUI assets on mobile（Android/iOS/MacCatalyst 会把它们放进
		     assets/licenses/，这也是 FileSystem.OpenAppPackageFileAsync("licenses/…") 在运行时唯一能读到的副本）。
		     ★ Windows 不要走这里：MAUI 资产在 Windows 上同样会被拷进输出目录，会和下面那份 Content
		       在包里形成两份逐字节相同的 LICENSE/NOTICE（实测重复 4 个文件 21.9 KB），所以这里排掉 Windows。 -->
		<MauiAsset Include="..\LICENSE" LogicalName="licenses\LICENSE" Condition="!$(TargetFramework.Contains('-windows'))" />
		<MauiAsset Include="..\NOTICE" LogicalName="licenses\NOTICE" Condition="!$(TargetFramework.Contains('-windows'))" />
		<MauiAsset Include="..\THIRD_PARTY_NOTICES.md" LogicalName="licenses\THIRD_PARTY_NOTICES.md" Condition="!$(TargetFramework.Contains('-windows'))" />
		<MauiAsset Include="..\CONTENT_ATTRIBUTION.md" LogicalName="licenses\CONTENT_ATTRIBUTION.md" Condition="!$(TargetFramework.Contains('-windows'))" />
		<MauiAsset Include="..\licenses\OFL-1.1.txt" LogicalName="licenses\OFL-1.1.txt" Condition="!$(TargetFramework.Contains('-windows'))" />
		<MauiAsset Include="..\licenses\WebView2-LICENSE.txt" LogicalName="licenses\WebView2-LICENSE.txt" Condition="!$(TargetFramework.Contains('-windows'))" />
		<MauiAsset Include="..\licenses\WebView2-NOTICE.txt" LogicalName="licenses\WebView2-NOTICE.txt" Condition="!$(TargetFramework.Contains('-windows'))" />

		<!-- Windows：exe 旁边放 4 份主声明，licenses\ 放 3 份第三方文本（与仓库结构一致，和上面的 MauiAsset 互补，不重复） -->
		<Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />
		<Content Include="..\NOTICE" Link="NOTICE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />
		<Content Include="..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />
		<Content Include="..\CONTENT_ATTRIBUTION.md" Link="CONTENT_ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />
		<Content Include="..\licenses\OFL-1.1.txt" Link="licenses\OFL-1.1.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />
		<Content Include="..\licenses\WebView2-LICENSE.txt" Link="licenses\WebView2-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />
		<Content Include="..\licenses\WebView2-NOTICE.txt" Link="licenses\WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="$(TargetFramework.Contains('-windows'))" />

		<!-- App Icon -->
		<MauiIcon Condition="!$(TargetFramework.Contains('-android')) AND !$(TargetFramework.Contains('-ios'))" Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" />

		<MauiIcon Condition="$(TargetFramework.Contains('-android'))" Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" ForegroundScale="0.57" />

		<MauiIcon Condition="$(TargetFramework.Contains('-ios'))" Include="Resources\AppIcon\appicon.png" Color="#FFFFFF" ForegroundScale="0.9" />
		
		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\appicon.png" Color="#5a433a" BaseSize="128,128" />

		<!-- 悬浮图标窗用的图标：Win32 侧按路径直接读取，随输出复制到 Utils 目录 -->
		<Content Include="Resources\AppIcon\appicon.png" Link="Utils\appicon.png" CopyToOutputDirectory="PreserveNewest" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- ★★ NativeAOT 裁剪保留指令（2026-10-02 曾整组误删，导致 AOT 包"一直 loading"）。
	     TrimmerRootAssembly=Terraria_Wiki 让 ILC 保留整个应用程序集 —— 缺了它
	     Razor 组件的渲染树会被裁掉：前端 AttachPage 发出后 OnRenderCompleted 永不返回，
	     DOM 里 #app 一直为空（Debug 版正常，AOT 版空），非常隐蔽。
	     SQLite-net 同理由其反射式 ORM 映射需要。
	     rd.xml 保留 JSInterop 的 TaskGenericsUtil.TcsResultSetter<T>（运行时反射构造泛型）。 -->
	<ItemGroup Condition="$(TargetFramework.Contains('-windows')) AND '$(Configuration)' == 'Release'">
		<RdXmlFile Include="rd.xml" />
		<TrimmerRootAssembly Include="Terraria_Wiki" />
		<TrimmerRootAssembly Include="SQLite-net" />
	</ItemGroup>

	<ItemGroup>
	  <Content Remove="Resources\Raw\default-wikibooks.json" />
	  <Content Remove="Resources\Raw\Languages\en-us.json" />
	  <Content Remove="Resources\Raw\Languages\zh-cn.json" />
	</ItemGroup>

	<ItemGroup>

		<PackageReference Include="HtmlAgilityPack" Version="1.12.4" />

		<PackageReference Include="LuYao.TlsClient" Version="1.2.0" />
		<!-- .NET 11 / MAUI 11（当前为 RC.2，GA 后需改为正式版本号） -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0-rc.2.26505.5" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="11.0.0-rc.2.26505.5" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" Condition="$(TargetFramework.Contains('-windows'))" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0-rc.3.26522.148" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />

	</ItemGroup>

</Project>
