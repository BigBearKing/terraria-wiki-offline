@page "/settings"
@inject AppTaskRunner TaskRunner
@inject PackageService PackageService
@using System.ComponentModel
@using Terraria_Wiki.Services
@using Terraria_Wiki.Components.Controls
<div class="page-anim page-content">
    <header class="page-header">
        <span class="content-title">@Loc.Get("Settings.Title")</span>
    </header>

    <div class="list-container setting-list">

        <div class="category-card">
            <span class="category-title">@Loc.Get("Settings.Personalization")</span>

            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Common.Language")</span>
                </div>
                <CustomSelect TValue="string"
                              Options="LanguageOptions"
                              @bind-Value="SelectedLanguage" />
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.DefaultColorTheme")</span>
                </div>
                <CustomSelect TValue="string"
                              Options="AppThemeOptions"
                              @bind-Value="AppTheme" />
            </div>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.ContentColorTheme")</span>
                </div>
                <CustomSelect TValue="string"
                              Options="ContentThemeOptions"
                              @bind-Value="ContentTheme" />
            </div>
        </div>

        @if (AppState.IsAndroid)
        {
            <div class="category-card">
                <span class="category-title">@Loc.Get("Settings.Permissions")</span>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">@Loc.Get("Settings.NetworkPermission")</span>
                        <span class="setting-desc">@Loc.Get("Settings.NetworkPermissionDesc")</span>
                    </div>
                    <button class="button setting-btn"
                            disabled="@IsPermissionGranted(AndroidPermissionType.Network)"
                            @onclick="() => RequestPermissionAsync(AndroidPermissionType.Network)">
                        @GetPermissionButtonText(AndroidPermissionType.Network)
                    </button>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">@Loc.Get("Settings.NotificationPermission")</span>
                        <span class="setting-desc">@Loc.Get("Settings.NotificationPermissionDesc")</span>
                    </div>
                    <button class="button setting-btn"
                            disabled="@IsPermissionGranted(AndroidPermissionType.Notifications)"
                            @onclick="() => RequestPermissionAsync(AndroidPermissionType.Notifications)">
                        @GetPermissionButtonText(AndroidPermissionType.Notifications)
                    </button>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">@Loc.Get("Settings.BackgroundPermission")</span>
                        <span class="setting-desc">@Loc.Get("Settings.BackgroundPermissionDesc")</span>
                    </div>
                    <button class="button setting-btn"
                            disabled="@IsPermissionGranted(AndroidPermissionType.Background)"
                            @onclick="() => RequestPermissionAsync(AndroidPermissionType.Background)">
                        @GetPermissionButtonText(AndroidPermissionType.Background)
                    </button>
                </div>
            </div>
        }
        @if (AppState.IsWindows)
        {
            <div class="category-card">
                <span class="category-title">@Loc.Get("Settings.Shortcuts")</span>
                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">@Loc.Get("Settings.SideButtonBack")</span>
                        <span class="setting-desc">@Loc.Get("Settings.SideButtonBackDesc")</span>
                    </div>
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="IsSideButtonBack">
                        <span class="slider"></span>
                    </label>
                </div>
            </div>
        }
        <div class="category-card">
            <span class="category-title">@Loc.Get("Common.Search")</span>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.MaxSearchCount")</span>
                </div>
                <CustomSelect TValue="int"
                              Options="MaxSearchItemCountOptions"
                              @bind-Value="MaxSearchItemCount" />
            </div>
        </div>

        <div class="category-card">
            <span class="category-title">@Loc.Get("Common.Download")</span>

            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.PageDownloadThreads")</span>
                </div>
                <CustomSelect TValue="int"
                              Options="PageConcurrencyOptions"
                              @bind-Value="PageConcurrency" />
            </div>

            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.AssetDownloadThreads")</span>
                </div>
                <CustomSelect TValue="int"
                              Options="ResConcurrencyOptions"
                              @bind-Value="ResConcurrency" />
            </div>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.ErrorRetryCount")</span>
                </div>
                <CustomSelect TValue="int"
                              Options="MaxRetryAttemptsOptions"
                              @bind-Value="MaxRetryAttempts" />
            </div>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.ClearFailedList")</span>
                    <span class="setting-desc">@Loc.Get("Settings.ClearFailedListDesc")</span>
                </div>
                <button class="button setting-btn" @onclick="ClearFailedList">
                    @Loc.Get("Settings.ClearFailedList")
                </button>
            </div>

        </div>
        <div class="category-card">
            <span class="category-title">@Loc.Get("Settings.Database")</span>

            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.ImportData")</span>
                    <span class="setting-desc">@Loc.Get("Settings.ImportDataDesc")</span>
                </div>
                <button class="button setting-btn" @onclick="ImportData">
                    @(AppState.ActiveTasks.Any(x => x.Task.TaskType == AppTaskType.ImportData) ? AppState.Tasks[AppTaskType.ImportData].GetProcessingText(Loc) : Loc.Get("Settings.SelectFile"))
                </button>
            </div>
        </div>

        @if (AppState.IsWindows)
        {
            <div class="category-card">
                <span class="category-title">@Loc.Get("Settings.DataLocation")</span>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">@Loc.Get("Settings.DataLocationMode")</span>
                        <span class="setting-desc">@Loc.Get("Settings.DataLocationDesc")</span>
                    </div>
                    <CustomSelect TValue="StorageLocationMode"
                                  Options="StorageLocationOptions"
                                  @bind-Value="PendingStorageMode" />
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">@(PendingStorageMode == StorageLocationMode.Custom ? Loc.Get("Settings.DataLocationCustom") : Loc.Get("Settings.DataLocationDefault"))</span>
                        <span class="setting-desc">@SelectedStoragePathText</span>
                    </div>
                    @if (PendingStorageMode == StorageLocationMode.Custom)
                    {
                        <button class="button setting-btn" @onclick="ChooseCustomStoragePath">
                            @Loc.Get("Settings.SelectFolder")
                        </button>
                    }
                </div>


                @if (HasStorageLocationChanges)
                {
                    <div class="setting-item">
                        <div class="setting-info">
                            <span class="setting-desc">@Loc.Get("Settings.DataLocationApplyDesc")</span>
                        </div>
                        <button class="button setting-btn" @onclick="SaveStorageLocation">
                            @Loc.Get("Common.Apply")
                        </button>
                    </div>
                }
            </div>
        }
        <div class="category-card">
            <span class="category-title">@Loc.Get("Common.Log")</span>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.ExportLog")</span>
                    <span class="setting-desc">@Loc.Get("Settings.ExportLogDesc")</span>
                </div>
                <button class="button setting-btn" @onclick="ExportLog">
                    @Loc.Get("Common.Export")
                </button>
            </div>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.DeleteLog")</span>
                    <span class="setting-desc">@Loc.Get("Settings.DeleteLogDesc")</span>
                </div>
                <button class="button setting-btn" @onclick="DeleteLog">
                    @Loc.Get("Settings.DeleteLog")
                </button>
            </div>
        </div>
        <div class="category-card">
            <span class="category-title">@Loc.Get("Settings.About")</span>

            <div class="setting-item">
                <div class="setting-info" @onclick="OnVersionLabelClicked">
                    <span class="setting-name">@Loc.Get("Common.Version")</span>
                    <span class="setting-desc">
                        v@(AppVersion)
                        @if (AppState.IsWindows)
                        {
                            <text> (Build @BuildNumber)</text>
                        }
                    </span>
                </div>
                <button class="button setting-btn" @onclick="CheckUpdateCommand">
                    @(AppState.ActiveTasks.Any(x => x.Task.TaskType == AppTaskType.CheckUpdate) ? AppState.Tasks[AppTaskType.CheckUpdate].GetProcessingText(Loc) : Loc.Get("Settings.CheckUpdate"))
                </button>
            </div>
            <div class="setting-item">
                <div class="setting-info">
                    <span class="setting-name">@Loc.Get("Settings.Author")</span>
                    <span class="setting-desc">@Author</span>
                </div>
                <button class="button setting-btn" @onclick="GotoGithub">
                    <Icon Name="github" />
                </button>
            </div>
        </div>

    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (AppState.IsWindows)
        {
            _pendingStorageMode = App.StoragePath!.LocationMode;
            _pendingCustomPath = App.StoragePath.CustomPath;
        }
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        Loc.OnChange += RefreshUI;
#if ANDROID
        AndroidPermissionService.PermissionStateChanged += RefreshUI;
#endif
    }

    private StorageLocationMode _pendingStorageMode;
    private string? _pendingCustomPath;

    private StorageLocationMode PendingStorageMode
    {
        get => _pendingStorageMode;
        set
        {
            _pendingStorageMode = value;
            StateHasChanged();
        }
    }

    private string SelectedStoragePath =>
        PendingStorageMode == StorageLocationMode.Default
            ? App.StoragePath!.DefaultPath
            : _pendingCustomPath;

    private string SelectedStoragePathText =>
        SelectedStoragePath ?? Loc.Get("Settings.DataLocationNotSelected");

    private bool HasStorageLocationChanges =>
        AppState.IsWindows &&
        !string.IsNullOrWhiteSpace(SelectedStoragePath) &&
        !AreSamePath(SelectedStoragePath, AppState.DataRootPath);

    private static bool AreSamePath(string? left, string? right)
    {
        if (string.IsNullOrWhiteSpace(left) || string.IsNullOrWhiteSpace(right))
            return false;

        try
        {
            return string.Equals(
                Path.GetFullPath(left).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                Path.GetFullPath(right).TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar),
                StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private async Task ChooseCustomStoragePath()
    {
#if WINDOWS
        var path = await FileHelper.PickFolderWindowsAsync();
        if (!string.IsNullOrWhiteSpace(path))
        {
            _pendingCustomPath = path;
            await InvokeAsync(StateHasChanged);
        }
#endif
    }

    private async Task SaveStorageLocation()
    {
        if (_pendingStorageMode == StorageLocationMode.Custom && string.IsNullOrWhiteSpace(_pendingCustomPath))
        {
            AppState.TriggerAlert(Loc.Get("Common.Notice"), Loc.Get("Settings.DataLocationNotSelected"));
            return;
        }

        var changed = await AppService.SwitchStorageLocationAsync(_pendingStorageMode, _pendingCustomPath);
        if (changed)
        {
            _pendingCustomPath = App.StoragePath!.CustomPath;
            await InvokeAsync(StateHasChanged);
            AppState.TriggerAlert(Loc.Get("Common.Notice"), Loc.Get("Settings.DataLocationApplied"));
        }
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        Loc.OnChange -= RefreshUI;
#if ANDROID
        AndroidPermissionService.PermissionStateChanged -= RefreshUI;
#endif
    }

    private void RefreshUI()
    {
        InvokeAsync(StateHasChanged);
    }

    private bool IsPermissionGranted(AndroidPermissionType permission)
    {
#if ANDROID
        return AndroidPermissionService.IsGranted(permission);
#else
        return false;
#endif
    }

    private string GetPermissionButtonText(AndroidPermissionType permission) =>
        IsPermissionGranted(permission)
            ? Loc.Get("Settings.PermissionGranted")
            : Loc.Get("Settings.PermissionRequest");

    private async Task RequestPermissionAsync(AndroidPermissionType permission)
    {
#if ANDROID
        await AndroidPermissionService.RequestAsync(permission);
        await InvokeAsync(StateHasChanged);
#endif
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // 只关心主题和置顶状态（对应 UI 开关）
        if (e.PropertyName is nameof(AppState.IsDarkTheme) or nameof(AppState.IsPinned))
            RefreshUI();
    }

    private IReadOnlyList<SelectOption<string>> LanguageOptions =>
        LocalizationService.SupportedLanguages
            .Select(language => new SelectOption<string>(language.Code, language.Name))
            .ToList();

    private IReadOnlyList<SelectOption<string>> AppThemeOptions =>
    [
        new("auto", Loc.Get("Settings.FollowSystem")),
        new("light", Loc.Get("Settings.LightMode")),
        new("dark", Loc.Get("Settings.DarkMode"))
    ];

    private IReadOnlyList<SelectOption<string>> ContentThemeOptions =>
    [
        new("auto", Loc.Get("Settings.FollowUI")),
        new("original", Loc.Get("Settings.WikiOriginal"))
    ];

    private IReadOnlyList<SelectOption<int>> MaxSearchItemCountOptions =>
    [
        new(25, "25"),
        new(50, Loc.Get("Settings.Default50")),
        new(75, "75"),
        new(100, "100")
    ];

    private IReadOnlyList<SelectOption<int>> PageConcurrencyOptions =>
    [
        new(1, "1"),
        new(2, Loc.Get("Settings.Default2")),
        new(3, "3")
    ];

    private IReadOnlyList<SelectOption<int>> ResConcurrencyOptions =>
    [
        new(1, "1"),
        new(5, "5"),
        new(10, Loc.Get("Settings.Default10")),
        new(15, "15"),
        new(20, "20")
    ];

    private IReadOnlyList<SelectOption<int>> MaxRetryAttemptsOptions =>
    [
        new(0, Loc.Get("Settings.NoRetry")),
        new(1, "1"),
        new(5, Loc.Get("Settings.Default5")),
        new(10, "10"),
        new(15, "15"),
        new(20, "20")
    ];

    private IReadOnlyList<SelectOption<StorageLocationMode>> StorageLocationOptions =>
    [
        new(StorageLocationMode.Default, Loc.Get("Settings.DataLocationDefault")),
        new(StorageLocationMode.Custom, Loc.Get("Settings.DataLocationCustom"))
    ];

    private string SelectedLanguage
    {
        get => Loc.CurrentLanguage;
        set
        {
            _ = Loc.SetLanguageAsync(value);
        }
    }

    private string AppTheme
    {
        get => ThemeService.AppTheme;
        set
        {
            _ = ThemeService.SetAppThemeAsync(value);
        }
    }

    private string ContentTheme
    {
        get => ThemeService.ContentTheme;
        set
        {
            _ = ThemeService.SetContentThemeAsync(value);
        }
    }

    private bool IsSideButtonBack
    {
        // 页面一加载，就会执行 get，从存储中读取状态。如果之前没存过，默认返回 false（关）吗
        get => Preferences.Default.Get("IsSideButtonBack", true);

        // 当用户点击开关时，会自动执行 set，把新的状态存入手机存储
        set
        {
            Preferences.Default.Set("IsSideButtonBack", value);
        }
    }
    private int PageConcurrency
    {
        get => Preferences.Default.Get("PageConcurrency", 2);
        set
        {

            Preferences.Default.Set("PageConcurrency", value);
        }
    }
    private int ResConcurrency
    {
        get => Preferences.Default.Get("ResConcurrency", 10);
        set
        {

            Preferences.Default.Set("ResConcurrency", value);
        }
    }
    private int MaxRetryAttempts
    {
        get => Preferences.Default.Get("MaxRetryAttempts", 5);
        set
        {

            Preferences.Default.Set("MaxRetryAttempts", value);
        }
    }
    private int MaxSearchItemCount
    {
        get => Preferences.Default.Get("MaxSearchItemCount", 50);
        set
        {

            Preferences.Default.Set("MaxSearchItemCount", value);
        }
    }
    private string AppVersion => AppInfo.Current.Version.ToString(3);
    private string BuildNumber => typeof(App).Assembly
        .GetCustomAttributes(false)
        .OfType<System.Reflection.AssemblyMetadataAttribute>()
        .FirstOrDefault(metadata => metadata.Key == "ApplicationBuildNumber")?.Value
        ?? AppInfo.Current.BuildString;
    private string Author => "BigBearKing";
    private async Task ImportData()
    {
        await PackageService.ImportDataAsync();
    }

    private async Task ExportLog()
    {
        await TaskRunner.RunAsync(
            AppTaskType.ExportLog,
            _ => App.LogManager!.ExportLogsAsync());
    }

    private async Task DeleteLog()
    {
        bool confirm = await Application.Current.Windows[0].Page.DisplayAlertAsync(Loc.Get("Settings.ConfirmDeleteLog"), Loc.Get("Settings.ConfirmDeleteLogDesc"), Loc.Get("Common.OK"), Loc.Get("Common.Cancel"));
        if (confirm)
        {
            await TaskRunner.RunAsync(
                AppTaskType.DeleteLog,
                _ =>
                {
                    App.LogManager?.DeleteLogs();
                    return Task.CompletedTask;
                });
        }
    }

    private async Task CheckUpdateCommand()
    {
        await TaskRunner.RunAsync(
            AppTaskType.CheckUpdate,
            async _ =>
        {
            var updateService = new UpdateService();
            var result = await updateService.CheckForUpdatesAsync();

            if (result != null && result.IsUpdateAvailable)
            {
                // 发现新版本，弹出提示框
                bool wantsToUpdate = await Application.Current.Windows[0].Page.DisplayAlertAsync(
                    Loc.Get("Settings.NewVersionFound", result.LatestVersion),
                    Loc.Get("Settings.ReleaseNotes", result.ReleaseNotes),
                    Loc.Get("Settings.GoToDownload"),
                    Loc.Get("Settings.Later"));

                if (wantsToUpdate)
                {
                    // 调用系统默认浏览器打开 GitHub Release 页面
                    await Browser.Default.OpenAsync(result.DownloadUrl, BrowserLaunchMode.SystemPreferred);
                }
            }
            else
            {
                AppState.TriggerAlert(Loc.Get("Common.Notice"), Loc.Get("Settings.AlreadyLatest"));
            }
        },
        new AppTaskOptions { ShowError = false });
    }
    private async Task GotoGithub()
    {
        await Browser.Default.OpenAsync("https://github.com/BigBearKing/terraria-wiki-offline", BrowserLaunchMode.SystemPreferred);
    }

    private async Task ClearFailedList()
    {
        bool confirm = await Application.Current.Windows[0].Page.DisplayAlertAsync(Loc.Get("Settings.ConfirmCleanup"), Loc.Get("Settings.ConfirmCleanupDesc"), Loc.Get("Common.OK"), Loc.Get("Common.Cancel"));
        if (confirm)
        {
            await App.DataManager.ClearFailedListAsync();
            await FileHelper.ClearAppCacheAsync();
        }
    }
    private int _clickCount = 0;
    private DateTime _lastClickTime;

    private void OnVersionLabelClicked()
    {
        var now = DateTime.Now;

        // 如果两次点击间隔超过 500ms，重置计数（防止用户平时误触累积）
        if ((now - _lastClickTime).TotalMilliseconds > 500)
        {
            _clickCount = 0;
        }

        _clickCount++;
        _lastClickTime = now;

        if (_clickCount == 7) // 连点 7 次触发
        {
            _clickCount = 0;

            AppService.NavigateTo("test");

        }
    }
}
