@page "/data"
@inject NavigationManager NavManager
@using System.ComponentModel
@using Terraria_Wiki
@using Terraria_Wiki.Components.Icons
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Terraria_Wiki.Services
@using Terraria_Wiki.Models

<div class="page-anim page-content">

    <header class="page-header">
        <span class="content-title">@Loc.Get("DataManagement.Title")</span>
    </header>

    <div class="list-container wiki-card-list">
        @* === 语言筛选 === *@
        <div class="lang-filter">
            <button class='lang-btn @(_langFilter == "all" ? "lang-active" : "")' @onclick='() => SetLangFilter("all")'>@Loc.Get("DataManagement.AllLanguages")</button>
            <button class='lang-btn @(_langFilter == "zh" ? "lang-active" : "")' @onclick='() => SetLangFilter("zh")'>@Loc.Get("DataManagement.Chinese")</button>
            <button class='lang-btn @(_langFilter == "en" ? "lang-active" : "")' @onclick='() => SetLangFilter("en")'>@Loc.Get("DataManagement.English")</button>
        </div>

        @* === 视图 1：Wiki 列表选择 === *@
        @if (_filteredWikiList != null && _filteredWikiList.Any())
        {
            @foreach (var wiki in _filteredWikiList)
            {
                <div class="manage-card button @(wiki.Id == AppState.ActiveWikiBookId ? "active-card" : "")" @onclick="() => OnCardClicked(wiki)">
                    <div class="manage-card-icon">
                        <img src="images/@wiki.DataFolder/logo.png" style="width: 48px;
                        height: 48px;object-fit: contain;" />
                    </div>
                    <div class="manage-card-info">
                        <div class="manage-card-title">@wiki.Title</div>
                        <div class="manage-card-desc">@wiki.Description</div>

                        @if (GetVisibleTask(wiki.Id) is AppTask AppTask)
                        {
                            <div class="manage-card-progress">
                                @GetTaskStatusText(AppTask) @AppTask.Progress.ToString("F1")%
                            </div>
                        }
                        else
                        {
                            <div class="manage-card-status @(wiki.IsPageDownloaded ? "status-ok" : "status-none")">
                                @(wiki.IsPageDownloaded ? Loc.Get("DataManagement.Installed") : Loc.Get("DataManagement.NotInstalled"))
                            </div>
                        }
                    </div>
                    <Icon Name="arrow-left" Size="20" style="transform: rotate(180deg); color: var(--text-secondary);" />
                </div>
            }
        }
        else
        {
            <div class="empty-state">@Loc.Get("DataManagement.NoWikiFound")</div>
        }

    </div>
</div>

@code {

    private List<WikiBook> _wikiBookList = [];
    private List<WikiBook> _filteredWikiList = [];
    private string _langFilter = "all";
    private bool _hasCustomLangFilter;
    private readonly Dictionary<int, AppTask> _downloadTasks = [];

    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        Loc.OnChange += RefreshUI;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        Loc.OnChange -= RefreshUI;
    }

    private void RefreshUI()
    {
        if (!_hasCustomLangFilter)
        {
            _langFilter = GetDefaultLangFilter();
            ApplyLangFilter();
        }

        InvokeAsync(StateHasChanged);
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // 只关心 ActiveWikiBookId 变化（切换 wiki 时重新加载列表）
        if (e.PropertyName == nameof(AppState.ActiveWikiBookId))
        {
            _hasCustomLangFilter = false;
            RefreshUI();
        }
        else if (e.PropertyName == nameof(AppState.CurrentDownloadTask))
        {
            if (AppState.CurrentDownloadTask?.WikiId is int wikiId)
                _downloadTasks[wikiId] = AppState.CurrentDownloadTask;
            RefreshUI();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _wikiBookList = await App.ManagerDb.GetItemsAsync<WikiBook>();
        var tasks = await App.ManagerDb.GetItemsAsync<AppTask>();
        foreach (var task in tasks.Where(t => t.WikiId.HasValue &&
                                              t.Status is AppTaskStatus.Paused or AppTaskStatus.Interrupted or AppTaskStatus.Failed)
                                    .GroupBy(t => t.WikiId!.Value)
                                    .Select(g => g.OrderByDescending(t => t.UpdatedTime).First()))
            _downloadTasks[task.WikiId!.Value] = task;
        _langFilter = GetDefaultLangFilter();
        ApplyLangFilter();
    }

    private string GetTaskStatusText(AppTask task) => task.Status switch
    {
        AppTaskStatus.Running when task.TaskType is AppTaskType.UpdatePages or AppTaskType.UpdateAll => Loc.Get("DataManagement.TaskUpdating"),
        AppTaskStatus.Running when task.TaskType == AppTaskType.RetryFailed => Loc.Get("DataManagement.TaskRetrying"),
        AppTaskStatus.Running => Loc.Get("DataManagement.TaskDownloading"),
        AppTaskStatus.Paused => Loc.Get("DataManagement.TaskPaused"),
        AppTaskStatus.Interrupted => Loc.Get("DataManagement.TaskInterrupted"),
        AppTaskStatus.Failed => Loc.Get("DataManagement.TaskFailed"),
        _ => Loc.Get("DataManagement.TaskPending")
    };

    private AppTask? GetVisibleTask(int wikiId)
    {
        var activeTask = AppState.GetCurrentDownloadTask(wikiId);
        if (activeTask is not null && !activeTask.IsInitialListFailure())
            return activeTask;

        return _downloadTasks.TryGetValue(wikiId, out var historyTask) &&
               !historyTask.IsInitialListFailure() &&
               historyTask.Status is AppTaskStatus.Paused or AppTaskStatus.Interrupted or AppTaskStatus.Failed
            ? historyTask
            : null;
    }

    private void SetLangFilter(string filter)
    {
        _langFilter = filter;
        _hasCustomLangFilter = true;
        ApplyLangFilter();
    }

    private string GetDefaultLangFilter()
    {
        var activeWiki = AppState.ActiveWikiBook
            ?? _wikiBookList.FirstOrDefault(w => w.Id == AppState.ActiveWikiBookId);

        return GetLangFilter(activeWiki?.Language)
            ?? GetLangFilter(AppState.CurrentLanguage)
            ?? "all";
    }

    private static string? GetLangFilter(string? language) =>
        language?.StartsWith("zh", StringComparison.OrdinalIgnoreCase) == true
            ? "zh"
            : language?.StartsWith("en", StringComparison.OrdinalIgnoreCase) == true
                ? "en"
                : null;

    private void ApplyLangFilter()
    {
        _filteredWikiList = _langFilter switch
        {
            "zh" => _wikiBookList.Where(w => string.Equals(w.Language, "zh", StringComparison.OrdinalIgnoreCase)).ToList(),
            "en" => _wikiBookList.Where(w => string.Equals(w.Language, "en", StringComparison.OrdinalIgnoreCase)).ToList(),
            _ => _wikiBookList
        };
    }

    private async Task OnCardClicked(WikiBook item)
    {
        if (item.Id == AppState.ActiveWikiBookId)
        {
            // 当前已选择的 Wiki → 直接进入详情
            AppState.CurrentPage = "data/" + item.Id;
            NavManager.NavigateTo($"/{AppState.CurrentPage}", false, true);
            return;
        }

        // 非当前 Wiki → 弹窗确认切换
        bool confirm = await Application.Current!.Windows[0].Page!.DisplayAlertAsync(
            Loc.Get("DataManagement.SwitchWikiTitle"),
            Loc.Get("DataManagement.SwitchWikiDesc", item.Title),
            Loc.Get("Common.OK"),
            Loc.Get("Common.Cancel"));

        if (confirm)
        {
            await AppService.SwitchWikiBookAsync(item.Id);
        }
    }





}
