@page "/data/{WikiId:int}"
@using System.ComponentModel
@using Terraria_Wiki.Components.Icons
@using Terraria_Wiki.Models
@using Terraria_Wiki.Services
@inject NavigationManager NavManager
@inject AppTaskRunner TaskRunner
@inject PackageService PackageService
<div class="page-anim page-content">
    <div class="header-with-back">
        <div class="icon-btn button" @onclick="BackToList">
            <Icon Name="arrow-left" Size="24" />
        </div>
        <span class="page-title">@_selectedWiki?.Title</span>
    </div>
    <div class="list-container detail-container">
        @if (_selectedWiki != null)
        {

            @* --- 状态 A：已下载 (显示数据大小、更新按钮、页面列表) --- *@
            <div class="title-placeholder">
                <div class="placeholder-icon">
                    <img src="images/@_selectedWiki.DataFolder/logo.png" style="
                    height: 85px;object-fit: contain;" />
                </div>
                <h3>@(_selectedWiki.IsPageDownloaded? _selectedWiki.Title : Loc.Get("DataManagementDetails.NoData"))</h3>
                <p>@(_selectedWiki.IsPageDownloaded? _selectedWiki.Description : Loc.Get("DataManagementDetails.DownloadRequired"))</p>
            </div>
            @if (_selectedWiki.IsPageDownloaded)
            {
                @* 1. 数据概览卡片 *@
                <div class="stats-panel">
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.DatabaseSize")</span>
                        <span class="stat-value">@FileHelper.GetSizeString(_selectedWiki.DataSize)</span>
                    </div>

                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.PageCount")</span>
                        <span class="stat-value">@_selectedWiki.PageCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.RedirectCount")</span>
                        <span class="stat-value">@_selectedWiki.RedirectCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.AssetCount")</span>
                        <span class="stat-value">@_selectedWiki.ResourceCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.LastUpdateTime")</span>
                        <span class="stat-value">@_selectedWiki.UpdateTime.ToString("yyyy-MM-dd\nHH:mm")</span>
                    </div>
                </div>

                @* 2. 操作按钮 *@
                <div class="action-row">
                    <div class="primary-btn btn-blue" @onclick="ToggleUpdate">
                        <Icon Name="sync" Size="16" />
                        @(IsUpdateRunning ? Loc.Get("Common.Pause") : GetUpdateButtonText())
                    </div>

                    <div class="primary-btn btn-green" @onclick="ExportData">
                        <Icon Name="export" Size="16" />
                        @(AppState.ActiveTasks.Any(x => x.Task.TaskType == AppTaskType.ExportData) ? AppState.Tasks[AppTaskType.ExportData].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.ExportData"))
                    </div>

                    @if (_hasFailedItems)
                    {
                        <div class="primary-btn btn-blue" @onclick="RetryFailedItems">
                            <Icon Name="sync" Size="16" />
                            @Loc.Get("DataManagementDetails.RetryFailedButton")
                        </div>
                    }

                    @if (_selectedWiki.IsResourceDownloaded)
                    {
                        <div class="primary-btn btn-red" @onclick="DeleteRes">
                            <Icon Name="delete" Size="16" />
                        @(AppState.ActiveTasks.Any(x => x.Task.TaskType == AppTaskType.DeleteResources) ? AppState.Tasks[AppTaskType.DeleteResources].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.DeleteAssets"))
                            
                        </div>
                    }
                    else
                    {
                        <div class="primary-btn btn-blue" @onclick="ToggleResourcesDownload">
                            <Icon Name="download" Size="16" />
                            @(IsResourceDownloadRunning ? Loc.Get("Common.Pause") : GetResourceDownloadButtonText())
                            
                        </div>
                    }


                    <div class="primary-btn btn-red" @onclick="DeleteDatabase">
                        <Icon Name="delete" Size="16" />
                        @(AppState.ActiveTasks.Any(x => x.Task.TaskType == AppTaskType.DeleteData) ? AppState.Tasks[AppTaskType.DeleteData].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.DeleteDatabase"))
                        
                    </div>
                </div>

            }
            else
            {
                <div class="download-actions">

                    @if (CurrentDownloadTask is null || CurrentDownloadTask.TaskType == AppTaskType.DownloadAll)
                    {
                        <div class="download-card">
                            <div class="dl-info">
                                <div class="dl-title">@Loc.Get("DataManagementDetails.AllContent")</div>
                                <div class="dl-desc">@Loc.Get("DataManagementDetails.AllContentDesc")</div>
                            </div>
                            <div class="primary-btn btn-blue" @onclick="() => ToggleDownload(true)">
                                @(IsDownloadRunning ? Loc.Get("Common.Pause") : GetDownloadButtonText(AppTaskType.DownloadAll))
                            </div>
                        </div>
                    }
                    @if (CurrentDownloadTask is null || CurrentDownloadTask.TaskType == AppTaskType.DownloadPages)
                    {
                        <div class="download-card">
                            <div class="dl-info">
                                <div class="dl-title">@Loc.Get("DataManagementDetails.BasicData")</div>
                                <div class="dl-desc">@Loc.Get("DataManagementDetails.BasicDataDesc")</div>
                            </div>
                            <div class="primary-btn btn-blue" @onclick="() => ToggleDownload(false)">
                                @(IsDownloadRunning ? Loc.Get("Common.Pause") : GetDownloadButtonText(AppTaskType.DownloadPages))
                            </div>
                        </div>
                    }
                </div>
            }

            @if (CurrentDownloadTask != null)
            {
                <div class="download-progress-panel">
                    <div class="download-progress-heading">
                        <span>@GetDownloadPhaseText()</span>
                        <span>@GetDownloadProgressText()</span>
                    </div>
                    <div class="download-progress-track" role="progressbar" aria-valuenow="@CurrentDownloadTask.Progress" aria-valuemin="0" aria-valuemax="100">
                        <div class="download-progress-fill @GetProgressBarClass()" style="@GetProgressStyle()"></div>
                    </div>
                    <div class="download-progress-count">@GetDownloadCountText()</div>
                </div>
            }

        }

    </div>
</div>
@code {
    [Parameter]
    public int WikiId { get; set; }

    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        Loc.OnChange += RefreshUI;
    }

    private AppTaskType _lastTaskType;

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        Loc.OnChange -= RefreshUI;
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // 任务进度保存时会更新 CurrentDownloadTask，任务完成后需重新加载 Wiki 统计数据。
        if (e.PropertyName is nameof(AppState.ActiveTasks) or nameof(AppState.CurrentDownloadTask))
            RefreshUI();
    }

    private async void RefreshUI()
    {
        // 任务刚完成且活动任务集合为空时，刷新页面数据
        if (_lastTaskType != AppTaskType.None && !AppState.HasActiveTasks)
        {
            _lastTaskType = AppTaskType.None;
            _selectedWiki = await App.ManagerDb.GetItemAsync<WikiBook>(WikiId);
            await AppService.RefreshWikiBookAsync(App.ManagerDb, App.ContentDb);
            _selectedWiki = await App.ManagerDb.GetItemAsync<WikiBook>(WikiId);
            _hasFailedItems = App.DataManager.HasFailedItems();
        }
        _lastTaskType = CurrentDownloadTask?.TaskType ?? AppTaskType.None;
        InvokeAsync(StateHasChanged);
    }

    private void BackToList()
    {
        AppState.CurrentPage = "data";
        NavManager.NavigateTo($"/{AppState.CurrentPage}", false, true);
    }

    private WikiBook _selectedWiki;
    private bool _hasFailedItems;
    private AppTask? CurrentDownloadTask => AppState.GetCurrentDownloadTask(WikiId);
    private bool IsDownloadRunning => CurrentDownloadTask?.Status == AppTaskStatus.Running;
    private bool IsResourceDownloadRunning => CurrentDownloadTask?.TaskType == AppTaskType.DownloadResources && IsDownloadRunning;
    private bool IsUpdateRunning => CurrentDownloadTask?.TaskType is AppTaskType.UpdatePages or AppTaskType.UpdateAll && IsDownloadRunning;
    private bool IsTaskPaused(AppTaskType taskType) =>
        CurrentDownloadTask?.TaskType == taskType && CurrentDownloadTask.Status is AppTaskStatus.Paused or AppTaskStatus.Interrupted;

    private string GetDownloadButtonText(AppTaskType taskType) =>
        IsTaskPaused(taskType) ? Loc.Get("Common.Resume") : Loc.Get("Common.Download");

    private string GetResourceDownloadButtonText() =>
        IsTaskPaused(AppTaskType.DownloadResources) ? Loc.Get("Common.Resume") : Loc.Get("DataManagementDetails.DownloadAssets");

    private string GetUpdateButtonText() =>
        IsTaskPaused(AppTaskType.UpdatePages) || IsTaskPaused(AppTaskType.UpdateAll)
            ? Loc.Get("Common.Resume")
            : Loc.Get("DataManagementDetails.CheckUpdate");

    protected override async Task OnInitializedAsync()
    {
        base.OnInitializedAsync();
        _selectedWiki = await App.ManagerDb.GetItemAsync<WikiBook>(WikiId);
        _hasFailedItems = App.DataManager.HasFailedItems();
    }

    private async Task ToggleDownload(bool includeResources)
    {
        if (IsDownloadRunning)
        {
            if (CurrentDownloadTask is not null && !await TaskRunner.PauseAsync(CurrentDownloadTask.Id))
                await App.DataManager.PauseDownloadAsync();
        }
        else
            await App.DataManager.StartOrResumeDownloadAsync(includeResources);
    }

    private async Task ToggleResourcesDownload()
    {
        if (IsResourceDownloadRunning)
        {
            if (CurrentDownloadTask is not null && !await TaskRunner.PauseAsync(CurrentDownloadTask.Id))
                await App.DataManager.PauseDownloadAsync();
        }
        else
            await App.DataManager.DownloadResourcesAsync();
    }

    private async Task ToggleUpdate()
    {
        if (IsUpdateRunning)
        {
            if (CurrentDownloadTask is not null && !await TaskRunner.PauseAsync(CurrentDownloadTask.Id))
                await App.DataManager.PauseDownloadAsync();
        }
        else
            await UpdateData();
    }

    private string GetDownloadPhaseText() => CurrentDownloadTask?.Phase switch
    {
        AppTaskPhase.FetchingLists => Loc.Get("DataManagementDetails.FetchingLists"),
        AppTaskPhase.DownloadingPages => Loc.Get("DataManagementDetails.DownloadingPages"),
        AppTaskPhase.DownloadingResources => Loc.Get("DataManagementDetails.DownloadingResources"),
        AppTaskPhase.PostProcessing => Loc.Get("DataManagementDetails.PostProcessing"),
        _ => Loc.Get("DataManagementDetails.Downloading")
    };

    private string GetDownloadProgressText() =>
        CurrentDownloadTask?.Phase == AppTaskPhase.FetchingLists
            ? Loc.Get("DataManagementDetails.ProgressIndeterminate")
            : $"{CurrentDownloadTask?.Progress:F1}%";

    private string GetProgressBarClass() =>
        CurrentDownloadTask?.Phase == AppTaskPhase.FetchingLists ? "indeterminate" : string.Empty;

    private string GetProgressStyle() =>
        CurrentDownloadTask?.Phase == AppTaskPhase.FetchingLists
            ? string.Empty
            : $"width:{Math.Clamp(CurrentDownloadTask?.Progress ?? 0, 0, 100):F2}%";

    private string GetDownloadCountText()
    {
        if (CurrentDownloadTask is null) return string.Empty;
        if (CurrentDownloadTask.Phase == AppTaskPhase.FetchingLists)
            return Loc.Get("DataManagementDetails.ListItemsFetched", CurrentDownloadTask.ListItemsFetched);

        return CurrentDownloadTask.Phase == AppTaskPhase.DownloadingResources
            ? $"{CurrentDownloadTask.CompletedResources} / {CurrentDownloadTask.TotalResources}"
            : $"{CurrentDownloadTask.CompletedPages} / {CurrentDownloadTask.TotalPages}";
    }


    private async Task RetryFailedItems()
    {
        await App.DataManager.RetryFailedItemsAsync();
    }

    private async Task UpdateData()
    {
        bool isAll = _selectedWiki.IsResourceDownloaded;

        await App.DataManager.UpdateDataAsync(isAll);

    }

    private async Task ExportData()
    {
        await PackageService.ExportDataAsync(WikiId);
    }

    private async Task DeleteRes()
    {
        bool isConfirmed = await Application.Current.Windows[0].Page?.DisplayAlertAsync(Loc.Get("Common.Notice"), Loc.Get("DataManagementDetails.ConfirmDeleteAssets"), Loc.Get("Common.OK"), Loc.Get("Common.Cancel"));
        if (isConfirmed)
        {
            await App.DataManager.DeleteResourcesAsync();

        }
    }

    private async Task DeleteDatabase()
    {
        bool isConfirmed = await Application.Current.Windows[0].Page?.DisplayAlertAsync(Loc.Get("Common.Notice"), Loc.Get("DataManagementDetails.ConfirmDeleteDatabase"), Loc.Get("Common.OK"), Loc.Get("Common.Cancel"));
        if (isConfirmed)
        {
            await App.DataManager.DeleteDatabaseAsync(WikiId);
            BackToList();
        }
    }

}

<style>

    .download-progress-panel {
        background-color: var(--bg-color-secondary);
        border-radius: 12px;
        padding: 14px 16px;
    }

    .download-progress-heading {
        display: flex;
        justify-content: space-between;
        color: var(--text-primary);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .download-progress-track {
        width: 100%;
        height: 8px;
        overflow: hidden;
        background-color: var(--hover-bg);
        border-radius: 999px;
    }

    .download-progress-fill {
        height: 100%;
        background-color: var(--blue-primary);
        border-radius: inherit;
        transition: width 0.25s ease;
    }

    .download-progress-fill.indeterminate {
        width: 35%;
        animation: download-progress-indeterminate 1.4s ease-in-out infinite;
    }

    @@keyframes download-progress-indeterminate {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(285%); }
    }

    .download-progress-count {
        color: var(--text-secondary);
        font-size: 0.8rem;
        margin-top: 6px;
    }

    .icon-btn {
        padding: 4px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .header-with-back {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: large;
        font-weight: 500;
    }

    /* === 详情页样式 === */
    .detail-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 0 0 max(12px, var(--safe-area-bottom));
    }

    /* 统计面板 */
    .stats-panel {
        background-color: var(--bg-color-secondary);
        border-radius: 16px;
        padding: 20px;
        /* 改用允许换行的 Flex 布局 */
        display: flex;
        flex-wrap: wrap;
        gap: 16px; /* 添加元素之间的间距 */
        align-items: stretch;
    }

    .stat-item {
        /* 核心：基础宽度设定为 120px，但允许它们自由放大（flex-grow: 1）或缩小 */
        flex: 1 1 120px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: 4px;
        text-align: center;
    }

    .stat-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        white-space: pre-line;
        text-align: center;
    }

    .action-row {
        display: grid;
        /* 默认状态（大屏）：一行 4 个，均分宽度 */
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    /* 当屏幕宽度小于特定值时触发 */
    @@media (max-width: 768px) {
        .action-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* 可选：如果屏幕极窄，强制变成单列 */
    @@media (max-width: 365px) {
        .action-row {
            grid-template-columns: 1fr;
        }
    }

    /* 通用按钮 */
    /* 1. 基础按钮样式重置 */
    .primary-btn {
        /* 移除之前的 background-color 和 color */
        padding: 12px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        gap: 8px;
        /* 关键：添加平滑过渡 */
        transition: all 0.2s;
        border: none;

    }

    /* 2. 交互反馈 (通用) */
    body.has-hover .primary-btn:hover {
        /* 悬停时：整体提亮 20% */
        /* 在深色背景下，brightness > 1 会让半透明色块显得更“实”、更亮 */
        filter: brightness(1.2);
    }
    

    .primary-btn:active {
        /* 点击时：稍微变暗并缩小，产生“按压感” */
        filter: brightness(1.0); /* 恢复亮度或稍微暗一点 */
        transform: scale(0.97); /* 物理回弹效果 */
    }

    /* === 颜色变体 (Tinted Style) === */

    /* 蓝色 */
    .btn-blue {
        background-color: var(--blue-tertiary);
        color: var(--blue-primary);
    }

    /* 绿色 */
    .btn-green {
        background-color: var(--green-tertiary);
        color: var(--green-primary);
    }

    /* 红色 */
    .btn-red {
        background-color: var(--red-tertiary);
        color: var(--red-primary);
    }

    .title-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 30px 20px;
        text-align: center;
    }

    .placeholder-icon {
        font-size: 4rem;
        margin-bottom: 16px;
    }

    .title-placeholder h3 {
        margin: 0 0 8px 0;
        color: var(--text-primary);
    }

    .title-placeholder p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .download-actions {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-bottom: 24px;
    }

    .download-card {
        background-color: var(--bg-color-secondary);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dl-title {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .dl-desc {
        font-size: 0.8rem;
        color: var(--text-secondary);
        line-height: 1.4;
    }

</style>