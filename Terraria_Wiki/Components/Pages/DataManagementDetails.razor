@page "/data/{WikiId:int}"
@using System.ComponentModel
@using Terraria_Wiki.Components.Icons
@using Terraria_Wiki.Models
@using Terraria_Wiki.Services
@inject NavigationManager NavManager
<div class="page-anim page-content">
    <div class="header-with-back">
        <div class="icon-btn button" @onclick="BackToList">
            <Icon Name="arrow-left" Size="24" />
        </div>
        <span class="page-title">@_selectedWiki?.Title</span>
    </div>
    <div class="list-container detail-container">
        @if (_selectedWiki != null)
        {

            @* --- 状态 A：已下载 (显示数据大小、更新按钮、页面列表) --- *@
            <div class="title-placeholder">
                <div class="placeholder-icon">
                    <img src="images/@_selectedWiki.DataFolder/logo.png" style="
                    height: 85px;object-fit: contain;" />
                </div>
                <h3>@(_selectedWiki.IsPageDownloaded? _selectedWiki.Title : Loc.Get("DataManagementDetails.NoData"))</h3>
                <p>@(_selectedWiki.IsPageDownloaded? _selectedWiki.Description : Loc.Get("DataManagementDetails.DownloadRequired"))</p>
            </div>
            @if (_selectedWiki.IsPageDownloaded)
            {
                @* 1. 数据概览卡片 *@
                <div class="stats-panel">
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.DatabaseSize")</span>
                        <span class="stat-value">@FileHelper.GetSizeString(_selectedWiki.DataSize)</span>
                    </div>

                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.PageCount")</span>
                        <span class="stat-value">@_selectedWiki.PageCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.RedirectCount")</span>
                        <span class="stat-value">@_selectedWiki.RedirectCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.AssetCount")</span>
                        <span class="stat-value">@_selectedWiki.ResourceCount</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-label">@Loc.Get("DataManagementDetails.LastUpdateTime")</span>
                        <span class="stat-value">@_selectedWiki.UpdateTime.ToString("yyyy-MM-dd\nHH:mm")</span>
                    </div>
                </div>

                @* 2. 操作按钮 *@
                <div class="action-row">
                    <div class="primary-btn btn-blue" @onclick="() => RunSafe(UpdateData)">
                        <Icon Name="sync" Size="16" />
                        @(AppState.ProcessingTaskId == 4 ? AppState.Tasks[4].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.CheckUpdate"))
                    </div>

                    <div class="primary-btn btn-green" @onclick="() => RunSafe(ExportData)">
                        <Icon Name="export" Size="16" />
                        @(AppState.ProcessingTaskId == 9 ? AppState.Tasks[9].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.ExportData"))
                    </div>

                    @if (_selectedWiki.IsResourceDownloaded)
                    {
                        <div class="primary-btn btn-red" @onclick="() => RunSafe(DeleteRes)">
                            <Icon Name="delete" Size="16" />
                            @(AppState.ProcessingTaskId == 6 ? AppState.Tasks[6].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.DeleteAssets"))
                            
                        </div>
                    }
                    else
                    {
                        <div class="primary-btn btn-blue" @onclick="ToggleResourcesDownload">
                            <Icon Name="download" Size="16" />
                            @(IsResourceDownloadRunning ? "暂停" : Loc.Get("DataManagementDetails.DownloadAssets"))
                            
                        </div>
                    }


                    <div class="primary-btn btn-red" @onclick="() => RunSafe(DeleteDatabase)">
                        <Icon Name="delete" Size="16" />
                        @(AppState.ProcessingTaskId == 8 ? AppState.Tasks[8].GetProcessingText(Loc) : Loc.Get("DataManagementDetails.DeleteDatabase"))
                        
                    </div>
                </div>

            }
            else
            {
                @if (CurrentDownloadTask != null)
                {
                    <div class="download-progress-panel">
                        <div class="download-progress-heading">
                            <span>@GetDownloadPhaseText()</span>
                            <span>@CurrentDownloadTask.Progress.ToString("F1")%</span>
                        </div>
                        <progress value="@CurrentDownloadTask.Progress" max="100"></progress>
                        <div class="download-progress-count">@GetDownloadCountText()</div>
                    </div>
                }
                <div class="download-actions">

                    <div class="download-card">
                        <div class="dl-info">
                            <div class="dl-title">@Loc.Get("DataManagementDetails.AllContent")</div>
                                <div class="dl-desc">@Loc.Get("DataManagementDetails.AllContentDesc")</div>
                        </div>
                        <div class="primary-btn btn-blue" @onclick="() => ToggleDownload(true)">
                            @(IsDownloadRunning ? "暂停" : Loc.Get("Common.Download"))
                        </div>
                    </div>
                    <div class="download-card">
                        <div class="dl-info">
                            <div class="dl-title">@Loc.Get("DataManagementDetails.BasicData")</div>
                                <div class="dl-desc">@Loc.Get("DataManagementDetails.BasicDataDesc")</div>
                        </div>
                        <div class="primary-btn btn-blue" @onclick="() => ToggleDownload(false)">
                            @(IsDownloadRunning ? "暂停" : Loc.Get("Common.Download"))
                            
                        </div>
                    </div>
                </div>
            }

        }

    </div>
</div>
@code {
    [Parameter]
    public int WikiId { get; set; }

    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        Loc.OnChange += RefreshUI;
    }

    private int _lastTaskId;

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        Loc.OnChange -= RefreshUI;
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // 只关心任务状态变化（任务完成后重新加载 Wiki 统计数据）
        if (e.PropertyName == nameof(AppState.ProcessingTaskId))
            RefreshUI();
    }

    private async void RefreshUI()
    {
        // 任务刚完成（ProcessingTaskId 从非零切回 0），刷新页面数据
        if (_lastTaskId != 0 && AppState.ProcessingTaskId == 0)
        {
            _lastTaskId = 0;
            _selectedWiki = await App.ManagerDb.GetItemAsync<WikiBook>(WikiId);
            await AppService.RefreshWikiBookAsync(App.ManagerDb, App.ContentDb);
            _selectedWiki = await App.ManagerDb.GetItemAsync<WikiBook>(WikiId);
        }
        _lastTaskId = AppState.ProcessingTaskId;
        InvokeAsync(StateHasChanged);
    }

    private void BackToList()
    {
        AppState.CurrentPage = "data";
        NavManager.NavigateTo(AppState.CurrentPage);
    }

    private WikiBook _selectedWiki;
    private DownloadTask? CurrentDownloadTask => AppState.CurrentDownloadTask?.WikiId == WikiId ? AppState.CurrentDownloadTask : null;
    private bool IsDownloadRunning => CurrentDownloadTask?.Status == DownloadTaskStatus.Running;
    private bool IsResourceDownloadRunning => CurrentDownloadTask?.TaskType == DownloadTaskType.DownloadResources && IsDownloadRunning;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitializedAsync();
        _selectedWiki = await App.ManagerDb.GetItemAsync<WikiBook>(WikiId);

        CheckFailList();


    }

    private async Task ToggleDownload(bool includeResources)
    {
        if (IsDownloadRunning)
            await App.DataManager.PauseDownloadAsync();
        else
            _ = App.DataManager.StartOrResumeDownloadAsync(includeResources);
    }

    private async Task ToggleResourcesDownload()
    {
        if (IsResourceDownloadRunning)
            await App.DataManager.PauseDownloadAsync();
        else
            _ = App.DataManager.DownloadResourcesAsync();
    }

    private string GetDownloadPhaseText() => CurrentDownloadTask?.Phase switch
    {
        DownloadTaskPhase.FetchingLists => "获取重定向和页面列表",
        DownloadTaskPhase.DownloadingPages => "下载页面",
        DownloadTaskPhase.DownloadingResources => "下载图片",
        DownloadTaskPhase.PostProcessing => "后续处理",
        _ => "下载"
    };

    private string GetDownloadCountText()
    {
        if (CurrentDownloadTask is null) return string.Empty;
        return CurrentDownloadTask.Phase == DownloadTaskPhase.DownloadingResources
            ? $"{CurrentDownloadTask.CompletedResources} / {CurrentDownloadTask.TotalResources}"
            : $"{CurrentDownloadTask.CompletedPages} / {CurrentDownloadTask.TotalPages}";
    }


    private async Task RunSafe(Func<Task> action)
    {
        // 统一检查
        if (AppState.ProcessingTaskId != 0)
        {
            AppState.TriggerAlert(Loc.Get("Common.Notice"), Loc.Get("DataManagementDetails.PleaseWait"));
            return;
        }
        await action();
    }

    private async Task CheckFailList()
    {
        if (App.DataManager.HasFailedItems())
        {
            bool result = await Application.Current.Windows[0].Page.DisplayAlertAsync(Loc.Get("Common.Notice"), Loc.Get("DataManagementDetails.RetryFailed"), Loc.Get("Common.Yes"), Loc.Get("Common.No"));
            if (result)
            {
                _ = App.DataManager.RetryFailedItemsAsync();
            }
        }

    }

    private async Task DownloadAll()
    {

        _ = App.DataManager.DownloadDataAsync(true);

    }

    private async Task DownloadPages()
    {

        _ = App.DataManager.DownloadDataAsync(false);

    }

    private async Task DownloadRes()
    {

        _ = App.DataManager.DownloadResourcesAsync();

    }

    private async Task UpdateData()
    {
        bool isAll = _selectedWiki.IsResourceDownloaded;

        _ = App.DataManager.UpdateDataAsync(isAll);

    }

    private async Task CleanUpRes()
    {
        _ = App.DataManager.CleanupResourcesAsync();

    }

    private async Task ExportData()
    {
        _ = App.DataManager?.ExportDataAsync(WikiId);
    }

    private async Task DeleteRes()
    {
        bool isConfirmed = await Application.Current.Windows[0].Page?.DisplayAlertAsync(Loc.Get("Common.Notice"), Loc.Get("DataManagementDetails.ConfirmDeleteAssets"), Loc.Get("Common.OK"), Loc.Get("Common.Cancel"));
        if (isConfirmed)
        {
            _ = App.DataManager.DeleteResourcesAsync();         

        }
    }

    private async Task DeleteDatabase()
    {
        bool isConfirmed = await Application.Current.Windows[0].Page?.DisplayAlertAsync(Loc.Get("Common.Notice"), Loc.Get("DataManagementDetails.ConfirmDeleteDatabase"), Loc.Get("Common.OK"), Loc.Get("Common.Cancel"));
        if (isConfirmed)
        {
            await App.DataManager.DeleteDatabaseAsync();
            BackToList();
        }
    }

}

<style>

    .download-progress-panel {
        background-color: var(--bg-color-secondary);
        border-radius: 12px;
        padding: 14px 16px;
    }

    .download-progress-heading {
        display: flex;
        justify-content: space-between;
        color: var(--text-primary);
        font-size: 0.9rem;
        margin-bottom: 8px;
    }

    .download-progress-panel progress {
        width: 100%;
        height: 8px;
        accent-color: var(--blue-primary);
    }

    .download-progress-count {
        color: var(--text-secondary);
        font-size: 0.8rem;
        margin-top: 6px;
    }

    .icon-btn {
        padding: 4px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .header-with-back {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: large;
        font-weight: 500;
    }

    /* === 详情页样式 === */
    .detail-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 0 0 max(12px, var(--safe-area-bottom));
    }

    /* 统计面板 */
    .stats-panel {
        background-color: var(--bg-color-secondary);
        border-radius: 16px;
        padding: 20px;
        /* 改用允许换行的 Flex 布局 */
        display: flex;
        flex-wrap: wrap;
        gap: 16px; /* 添加元素之间的间距 */
        align-items: stretch;
    }

    .stat-item {
        /* 核心：基础宽度设定为 120px，但允许它们自由放大（flex-grow: 1）或缩小 */
        flex: 1 1 120px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .stat-label {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: 4px;
        text-align: center;
    }

    .stat-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
        white-space: pre-line;
        text-align: center;
    }

    .action-row {
        display: grid;
        /* 默认状态（大屏）：一行 4 个，均分宽度 */
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    /* 当屏幕宽度小于特定值时触发 */
    @@media (max-width: 768px) {
        .action-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    /* 可选：如果屏幕极窄，强制变成单列 */
    @@media (max-width: 365px) {
        .action-row {
            grid-template-columns: 1fr;
        }
    }

    /* 通用按钮 */
    /* 1. 基础按钮样式重置 */
    .primary-btn {
        /* 移除之前的 background-color 和 color */
        padding: 12px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        gap: 8px;
        /* 关键：添加平滑过渡 */
        transition: all 0.2s;
        border: none;

    }

    /* 2. 交互反馈 (通用) */
    body.has-hover .primary-btn:hover {
        /* 悬停时：整体提亮 20% */
        /* 在深色背景下，brightness > 1 会让半透明色块显得更“实”、更亮 */
        filter: brightness(1.2);
    }
    

    .primary-btn:active {
        /* 点击时：稍微变暗并缩小，产生“按压感” */
        filter: brightness(1.0); /* 恢复亮度或稍微暗一点 */
        transform: scale(0.97); /* 物理回弹效果 */
    }

    /* === 颜色变体 (Tinted Style) === */

    /* 蓝色 */
    .btn-blue {
        background-color: var(--blue-tertiary);
        color: var(--blue-primary);
    }

    /* 绿色 */
    .btn-green {
        background-color: var(--green-tertiary);
        color: var(--green-primary);
    }

    /* 红色 */
    .btn-red {
        background-color: var(--red-tertiary);
        color: var(--red-primary);
    }

    .title-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 30px 20px;
        text-align: center;
    }

    .placeholder-icon {
        font-size: 4rem;
        margin-bottom: 16px;
    }

    .title-placeholder h3 {
        margin: 0 0 8px 0;
        color: var(--text-primary);
    }

    .title-placeholder p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .download-actions {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-bottom: 24px;
    }

    .download-card {
        background-color: var(--bg-color-secondary);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dl-title {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 4px;
    }

    .dl-desc {
        font-size: 0.8rem;
        color: var(--text-secondary);
        line-height: 1.4;
    }

</style>