@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager NavManager
@using System.ComponentModel
@using Terraria_Wiki.Components.Pages
@using Terraria_Wiki.Services

<div class="app-layout">
    <NavMenu />
    @if (AppState.LogPanelIsOpen)
    {
        <LogPanel />
    }
    <main class="main-area">      
        <TabBar />
        <TopBar />
        <div class="iframe-container page-anim"
             style="display: @(AppState.CurrentPage == "home" ? "block" : "none")">

            <iframe src="@src"
                    class="wiki-frame" id="wiki-frame">
            </iframe>
        </div>
        <div class="content-container" style="display: @(AppState.CurrentPage == "home" ? "none" : "block")">
            @Body
        </div>
    </main>
</div>

@code {

    string iframeTheme;
    string src;
    bool isMobile;

    //刷新机制
    protected override void OnInitialized()
    {

        AppState.PropertyChanged += OnAppStatePropertyChanged;
        AppState.OnWikiBookSwitched += OnWikiBookSwitched;
        AppState.OnShowAlert += HandleShowAlert;
        iframeTheme = ThemeService.GetIframeThemeState();
        isMobile = AppState.IsMobile;
        src = BuildWikiFrameUrl();

    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        AppState.OnWikiBookSwitched -= OnWikiBookSwitched;
        AppState.OnShowAlert -= HandleShowAlert;
    }

    private void RefreshUI()
    {
        InvokeAsync(StateHasChanged);
    }

    private string BuildWikiFrameUrl()
    {
        return $"http://127.0.0.1:55000?theme={iframeTheme}&isMobile={isMobile}&v={DateTime.UtcNow.Ticks}";
    }

    private void OnWikiBookSwitched()
    {
        src = BuildWikiFrameUrl();
        RefreshUI();
    }

    // 仅响应 LogPanelIsOpen 和 CurrentPage 变化
    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.LogPanelIsOpen) or nameof(AppState.CurrentPage))
            RefreshUI();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {

            AppState.Init(JS);
            IframeBridge.Init(JS);
            AppService.Init(NavManager, JS);
            await ThemeService.InitIframeThemeAsync(JS);
            await JS.InvokeVoidAsync("setPlatform", AppState.IsWindows ? "True" : "False");
            if (AppState.IsMobile)
            {
                await JS.InvokeVoidAsync("initHover", "False");
                await JS.InvokeVoidAsync("setSafeAreaTop", AppState.SafeAreaTop);
                await JS.InvokeVoidAsync("setSafeAreaBottom", AppState.SafeAreaBottom);
                await JS.InvokeVoidAsync("setSafeAreaLeft", AppState.SafeAreaLeft);
                await JS.InvokeVoidAsync("setSafeAreaRight", AppState.SafeAreaRight);
            }
            else
            {
                await JS.InvokeVoidAsync("initHover", "True");

            }
            _ = JS.InvokeVoidAsync("initGlobalScreenListener");

            await App.DataManager.InitializeSettings();

            // 旧版数据迁移：为 <a> 标签添加 data-wiki 属性

            var upgradeHandler = new LegacyUpgradeHandler();
            await upgradeHandler.MigrateAnchorDataWikiAsync(AppState.ActiveWikiBook);


            if (Application.Current?.Windows[0].Page is MainPage mainPage)
            {
                if (await mainPage.WaitForWebViewAsync(TimeSpan.FromSeconds(5)))
                {
                    await Task.Delay(100);
                    mainPage.HideLoadingScreen();
                }
                else
                {
                    await mainPage.ShowWebViewMissingAlertAsync();
                }

            }



        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void HandleShowAlert(string title, string message)
    {

        MainThread.BeginInvokeOnMainThread(async () =>
        {
            var mainPage = Application.Current?.Windows[0].Page;
            if (mainPage != null)
            {
                await mainPage.DisplayAlertAsync(title, message, App.Localization.Get("Common.OK"));
            }
        });
    }

}
