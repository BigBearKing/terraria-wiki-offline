@using System.ComponentModel
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@using Terraria_Wiki.Components.Pages
@using Terraria_Wiki.Services
<Mask Show="AppState.SidebarIsExpanded" MobileOnly="true" ZIndex="1004" BackPriority="1005" OnClick="CloseSidebar" />

<div class="sidebar @(AppState.SidebarIsExpanded ? "expanded" : "collapsed")">

    <div class="sidebar-header" @onclick="ToggleSidebar">
        <div class="icon-container">
            <img src="images/logo.svg" alt="App Logo" class="app-icon" />
        </div>
        <div class="text-container">
            <span class="app-title">@AppState.AppName</span>
        </div>
    </div>

    <nav class="nav-items">

        <button class="nav-item button @GetActiveClass("home")" @onclick='() => AppService.NavigateTo("home")'>
            <div class="icon-container">
                <Icon Name="main"></Icon>
            </div>
            <span class="text-container">@App.Localization!.Get("Common.Home")</span>
        </button>

        <button class="nav-item button @GetActiveClass("favorites")" @onclick='() => AppService.NavigateTo("favorites")'>
            <div class="icon-container">
                <Icon Name="favorites"></Icon>
            </div>
            <span class="text-container">@App.Localization!.Get("Common.Favorites")</span>
        </button>

        <button class="nav-item button @GetActiveClass("history")" @onclick='() => AppService.NavigateTo("history")'>
            <div class="icon-container">
                <Icon Name="history"></Icon>
            </div>
            <span class="text-container">@App.Localization!.Get("Common.History")</span>
        </button>

        <button class="nav-item button @GetActiveClass("all-pages")" @onclick='() => AppService.NavigateTo("all-pages")'>
            <div class="icon-container">
                <Icon Name="all-pages"></Icon>
            </div>
            <span class="text-container">@App.Localization!.Get("Common.Pages")</span>
        </button>

        <button class="nav-item button @GetActiveClass("data")" @onclick='() => AppService.NavigateTo("data")'>
            <div class="icon-container">
                <Icon Name="data"></Icon>
            </div>
            <span class="text-container">@App.Localization!.Get("Common.Data")</span>
        </button>

        <button class="nav-item button @GetActiveClass("settings")" @onclick='() => AppService.NavigateTo("settings")'>
            <div class="icon-container">
                <Icon Name="settings"></Icon>
            </div>
            <span class="text-container">@App.Localization!.Get("Common.Settings")</span>
        </button>

    </nav>

    <div class="sidebar-footer">
        <button class="nav-item button" @onclick="ToggleLogPanel">
            <div class="icon-container @(AppState.HasActiveTasks ? "rotating" : "")" style=" @(AppState.HasActiveTasks ? "color:var(--blue-primary)" : "")">
                <Icon Name="sync"> </Icon>
            </div>
            <span class="text-container">
                @App.Localization!.Get("Common.Log")
            </span>
        </button>
        <button class="nav-item theme-toggle button" @onclick="ToggleTheme">
            <div class="icon-container">
                <Icon Name=@(AppState.IsDarkTheme ? "sun" : "moon")> </Icon>
            </div>
            <span class="text-container">
                @App.Localization!.Get(AppState.IsDarkTheme ? "NavMenu.SwitchToLight" : "NavMenu.SwitchToDark")
            </span>
        </button>
    </div>



</div>

@code {
    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        App.Localization!.OnChange += RefreshUI;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        App.Localization!.OnChange -= RefreshUI;
    }

    private void RefreshUI()
    {
        InvokeAsync(StateHasChanged);
    }

    // 仅响应相关属性变化：CurrentPage, SidebarIsExpanded, ActiveTasks, IsDarkTheme
    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.CurrentPage) 
                            or nameof(AppState.SidebarIsExpanded) 
                            or nameof(AppState.ActiveTasks) 
                            or nameof(AppState.IsDarkTheme))
            RefreshUI();
    }
    // 核心逻辑：判断当前按钮是否应该高亮
    private string GetActiveClass(string pageName)
    {
        return AppState.CurrentPage.Contains(pageName) ? "actived" : "";
    }

    // 新增：点击遮罩层关闭侧边栏
    private void CloseSidebar()
    {
        AppState.SidebarIsExpanded = false;
    }

    private void ToggleSidebar()
    {
        AppState.SidebarIsExpanded = !AppState.SidebarIsExpanded;
    }

    private async Task ToggleTheme()
    {

        _ = ThemeService.ToggleTheme();
    }

    private void ToggleLogPanel()
    {
        if (AppState.IsSmallScreen)
        {
            AppState.SidebarIsExpanded = false;
        }
        AppState.LogPanelIsOpen = !AppState.LogPanelIsOpen;
    }
}