@using System.ComponentModel
@using Terraria_Wiki.Components.Pages
@using Terraria_Wiki.Services
@using Terraria_Wiki.Models
@inject IJSRuntime JS
<header class="top-bar">

    <div class="actions-wrapper">
        <button class="action-btn button mobile-menu-btn" title="@App.Localization!.Get("TopBar.Menu")" @onclick="OpenMobileSidebar">
            <img src="images/logo.svg" alt="Menu" style="width: 36px; height: 36px;" />
        </button>
        @if (ShouldShowActionButtons())
        {
            <button class="action-btn button" title="@App.Localization!.Get("TopBar.Back")" @onclick="WikiBackAsync">
                <Icon Name="arrow-left" Size="20"></Icon>
            </button>
            <button class="action-btn button" title="@App.Localization!.Get("Common.Home")" @onclick="WikiBackHomeAsync">
                <Icon Name="home" Size="20"></Icon>
            </button>
            <button class="action-btn button" title="@App.Localization!.Get("Common.Favorites")" disabled="@_isProcessing" style="@(_isFavorite ? "color:var(--blue-primary)" : "")" @onclick="ToggleFavoriteAsync">
                <Icon Name="@(_isFavorite ? "star-filled" : "star")" Size="20"></Icon>
            </button>
        }
    </div>
    <div class="page-title @(ShouldShowActionButtons() ? "" : "page-title-without-actions")" @onclick="WikiToTopAsync">@GetPageTitle()</div>


    @if (ShouldShowSearch())
    {
        <div id="search-wrapper" class="search-wrapper">
            <Icon class="search-icon" Name="search"></Icon>
            <input type="text" class="search-input" placeholder=@GetSearchPlaceholder() @bind="SearchText" @bind:event="oninput"/>
            @if (AppState.CurrentPage == "home")
            {
                <SearchResultPanel OnResultSelected="HandleResultClick" OnCloseRequested="ClearSearch" />
            }
        </div>
    }

    @if (ShouldShowPinButton())
    {
        <div class="actions-wrapper">
            <button class="action-btn button" title="@App.Localization!.Get("TopBar.PinToTop")" style="@(AppState.IsPinned ? "color:var(--blue-primary)" : "")" @onclick="TogglePinStateAsync">
                <Icon Name="@(AppState.IsPinned ? "pin-filled" : "pin")" Size="20"></Icon>
            </button>
        </div>
    }

    @if (AppState.CurrentPage == "home")
    {
        <div class="actions-wrapper">
            <button class="action-btn button mobile-btn" title="@App.Localization!.Get("TabBar.Tabs")" @onclick="ToggleMobileTabPanel">
                <Icon Name="more" Size="24"></Icon>
            </button>
        </div>
    }


</header>

@code {
    private bool _isFavorite = false;
    private bool _isProcessing = false;
    private string _searchText = "";
    private CancellationTokenSource? _debounceCts;
    public string SearchText
    {
        get => _searchText;
        set
        {

            if (_searchText != value)
            {
                _searchText = value;
                DebounceSearchAsync(_searchText);


            }
        }

    }

    protected override async Task OnParametersSetAsync()
    {
        _isFavorite = await IsFavoritePageAsync();
    }

    //刷新机制
    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        App.Localization!.OnChange += RefreshUI;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
        App.Localization!.OnChange -= RefreshUI;
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

    }

    private async void RefreshUI()
    {
        _isFavorite = await IsFavoritePageAsync();
        InvokeAsync(StateHasChanged);
    }

    // 仅响应相关属性变化：CurrentPage, CurrentWikiPage, IsPinned, Tabs, ActiveTabId
    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // CurrentPage 变化时额外清空搜索框
        if (e.PropertyName == nameof(AppState.CurrentPage))
            HandlePageChanged();

        // 只在相关属性变化时刷新
        if (e.PropertyName is nameof(AppState.CurrentPage) 
                            or nameof(AppState.CurrentWikiPage) 
                            or nameof(AppState.IsPinned) 
                            or nameof(AppState.Tabs) 
                            or nameof(AppState.ActiveTabId)
                            or nameof(AppState.MobileTabPanelOpen))
            RefreshUI();
    }

    // 当页面切换时，自动清空搜索框
    private void HandlePageChanged()
    {

        ClearSearch();
    }

    // 新增：移动端打开侧边栏
    private void OpenMobileSidebar()
    {
        AppState.SidebarIsExpanded = true;
    }

    // 新增：移动端切换垂直标签面板
    private void ToggleMobileTabPanel()
    {
        AppState.MobileTabPanelOpen = !AppState.MobileTabPanelOpen;
    }

    //
    private string GetPageTitle()
    {
        return AppState.CurrentPage switch
        {
            "home" => GetWikiTitle(),
            "favorites" => App.Localization!.Get("Common.Favorites"),
            "history" => App.Localization!.Get("Common.History"),
            "all-pages" => App.Localization!.Get("Common.Pages"),
            var p when p == "data" || p.StartsWith("data/") => App.Localization!.Get("Common.Data"),
            "settings" => App.Localization!.Get("Common.Settings"),
            _ => ""
        };
    }

    private string GetSearchPlaceholder()
    {
        return AppState.CurrentPage switch
        {
            "home" => App.Localization!.Get("TopBar.SearchPlaceholder"),
            _ => App.Localization!.Get("TopBar.MatchTitle")
        };
    }

    private bool ShouldShowActionButtons()
    {
        return AppState.CurrentPage switch
        {
            "home" => true,
            _ => false
        };
    }


    private bool ShouldShowSearch()
    {
        return AppState.CurrentPage switch
        {
            "home" or "favorites" or "history" or "all-pages" => true,
            _ => false
        };
    }

    private string GetWikiTitle()
    {
        return AppState.CurrentWikiPage;
    }

    private void WikiToTopAsync()
    {
        if (AppState.CurrentPage != "home") return;

        _ = IframeBridge.CallJsAsync("ToTop", "");
    }

    private void WikiBackAsync()
    {
        _ = AppService.WikiBackAsync();
    }

    private void WikiBackHomeAsync()
    {
        _ = AppService.WikiBackHomeAsync();
    }

    private async Task<bool> IsFavoritePageAsync()
    {
        return await App.ContentDb.ItemExistsAsync<WikiFavorite>(AppState.CurrentWikiPage);
    }

    // 新增一个处理状态标志
    private async Task ToggleFavoriteAsync()
    {
        // 1. 如果当前正在处理中，直接拦截忽略（防止连击的核心）
        if (_isProcessing) return;

        try
        {
            // 2. 上锁
            _isProcessing = true;

            if (_isFavorite)
            {
                _isFavorite = false;
                await App.ContentDb.DeleteItemAsync<WikiFavorite>(AppState.CurrentWikiPage);

            }
            else
            {
                var newFav = new WikiFavorite
                {
                    WikiTitle = AppState.CurrentWikiPage,
                    FavoritedAt = DateTime.Now
                };
                _isFavorite = true;
                await App.ContentDb.SaveItemAsync(newFav);

            }

            // 3. (可选体验优化) 如果本地数据库太快，瞬间就处理完了，
            // 用户可能还会凭手速连击。人为加 200 毫秒的“冷却时间”能极大提升稳定性和手感。
            await Task.Delay(200);
        }
        finally
        {
            // 4. 解锁：无论上面是成功、失败还是报错，finally 都会绝对执行，确保按钮恢复可用
            _isProcessing = false;
        }
    }

    // 搜索防抖逻辑
    private async void DebounceSearchAsync(string query)
    {
        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        try
        {
            // 体验优化：如果用户删空了输入框，不需要等，瞬间清空面板和列表！
            if (string.IsNullOrWhiteSpace(query))
            {
                ApplyDebouncedValue(query);
                return;
            }

            // 等待
            await Task.Delay(500, token);

            // 平安度过冷却期，统一分发状态
            ApplyDebouncedValue(query);
        }
        catch (TaskCanceledException)
        {
            // 用户手速过快被打断，忽略
        }
    }

    private void ApplyDebouncedValue(string query)
    {
        if (query.Contains('\''))
        {
            return;
        }
        AppState.SearchQuery = query;

        InvokeAsync(StateHasChanged);
    }
    // 当用户在弹出面板里点击了某一条结果
    private void HandleResultClick(string title)
    {
        ClearSearch();

        AppService.OpenPageAsync(title);
    }

    // 当用户点击了面板外面的空白处
    private void ClearSearch()
    {
        SearchText = "";
        AppState.SearchQuery = "";
    }

    private bool ShouldShowPinButton()
    {
        return AppState.IsWindows || AppState.IsMacCatalyst;
    }

    private async Task TogglePinStateAsync()
    {
        if (AppState.IsPinned)
        {
            WindowHelper.SetAlwaysOnTop(false);
            AppState.IsPinned = false;

        }
        else
        {
            WindowHelper.SetAlwaysOnTop(true);
            AppState.IsPinned = true;
        }
    }

    private void HandleKeyboardHeightChanged(double keyboardHeightDp)
    {
        InvokeAsync(async () =>
                {
                    await JS.InvokeVoidAsync("updateKeyboardHeight", keyboardHeightDp);
                });
    }


}
