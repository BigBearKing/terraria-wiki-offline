@using System.ComponentModel

@* 面板与遮罩都常驻 DOM，只切 .show / Show 状态 —— 与 NavMenu 的 Mask 同一套做法。
   若用 @if 包起来，Blazor 会在关闭时直接移除节点，CSS 只有入场 animation 会跑，
   退场无从播放（这就是"只有打开有动画"的根因）。改成 transition 后开/关对称。 *@
<Mask Show="AppState.MoreListOpen" Transparent="true" ZIndex="1002" BackPriority="1004" OnClick="CloseMoreList" />
<div class="more-list @(AppState.MoreListOpen ? "show" : "")" data-tauri-drag-region>
        @* 每个功能项两套文字：.btn-title 给宽屏（在按钮内部），
           .narrow-title 里的 .btn-title-narrow 给窄屏（在按钮外部下方）。由 CSS 按断点各自显隐。 *@
        @* 功能项的按钮 = IconButton（Wide36 档：高 36、图标 + 文字；窄屏切成 Square42 方块）。
           尺寸由 C# 的 AppState.IsSmallScreen 决定，不再用媒体查询盖组件尺寸 —— 与本组件
           "显隐/归属全由 C# 判断"的既有约定一致（见文件末尾的监听）。
           保留 .action-btn 类：index.html:153 的 fit() 靠它跳过字号自适应；本文件也用它做 ::deep 钩子。
           .btn-title-narrow（框外文字）仍在本文件自己的 markup 里，样式不动。 *@
        <div class="more-list-actions">
            <div class="action-item">
                <IconButton Size="@ActionsSize" Icon="text-search" IconSize="26" Text="@App.Localization!.Get("Common.FindInPage")"
                            Class="action-btn" Title="@App.Localization!.Get("Common.FindInPage")" OnClick="FindInPage" />
                <div class="narrow-title">
                    <div class="btn-title-narrow">@App.Localization!.Get("Common.FindInPage")</div>
                </div>
            </div>
            @* 置顶：只有 Windows 有无边框窗口置顶能力，Mac / 其他平台不提供 *@
            @if (AppState.IsWindows)
            {
                <div class="action-item">
                    <IconButton Size="@ActionsSize" Icon="@(AppState.IsPinned ? "pin-filled" : "pin")" IconSize="24"
                                Text="@App.Localization!.Get("TopBar.PinToTop")" Active="AppState.IsPinned" Toggle="true"
                                Class="action-btn" Title="@App.Localization!.Get("TopBar.PinToTop")" OnClick="TogglePinStateAsync" />
                    <div class="narrow-title">
                        <div class="btn-title-narrow">@App.Localization!.Get("TopBar.PinToTop")</div>
                    </div>
                </div>
            }
            @* 悬浮窗：只做 Windows（主窗口收缩后只留 wiki 视图 + 顶部小条） *@
            @if (AppState.IsWindows)
            {
                <div class="action-item">
                    <IconButton Size="@ActionsSize" Icon="floating-window" IconSize="24"
                                Text="@App.Localization!.Get("MoreList.FloatingWindow")" Active="AppState.FloatingSearchOpen" Toggle="true"
                                Class="action-btn" Title="@App.Localization!.Get("MoreList.FloatingWindow")" OnClick="ToggleFloatingSearch" />
                    <div class="narrow-title">
                        <div class="btn-title-narrow">@App.Localization!.Get("MoreList.FloatingWindow")</div>
                    </div>
                </div>
            }
            @* 缩放：宽屏 .zoom-wrapper 一整行「缩放 ……… − 100% +」；
               窄屏 .zoom-wrapper 隐藏，改用后面两个 .zoom-narrow 项，各自带框外文字 *@
            <div class="zoom-wrapper">
                <Icon Name="zoom-in" Size="24"></Icon>
                <div class="btn-title">@App.Localization!.Get("Settings.WikiZoom")</div>
                <div class="zoom-actions">
                    <IconButton Size="IconButtonSize.Square36" Icon="subtract" IconSize="20" Disabled="IsMinZoom"
                                Class="action-btn zoom-btn" Title="@App.Localization!.Get("MoreList.ZoomOutTitle")" OnClick="ZoomOut" />
                    <span class="zoom-percent">@(AppState.WikiZoom)%</span>
                    <IconButton Size="IconButtonSize.Square36" Icon="add" IconSize="20" Disabled="IsMaxZoom"
                                Class="action-btn zoom-btn" Title="@App.Localization!.Get("MoreList.ZoomInTitle")" OnClick="ZoomIn" />
                </div>
            </div>
            <div class="action-item zoom-narrow">
                <IconButton Size="IconButtonSize.Square42" Icon="zoom-out" IconSize="24" Disabled="IsMinZoom"
                            Class="action-btn zoom-btn" Title="@App.Localization!.Get("MoreList.ZoomOutTitle")" OnClick="ZoomOut" />
                <div class="narrow-title">
                    <div class="btn-title-narrow">@App.Localization!.Get("MoreList.ZoomOut")</div>
                </div>
            </div>
            <div class="action-item zoom-narrow">
                <IconButton Size="IconButtonSize.Square42" Icon="zoom-in" IconSize="24" Disabled="IsMaxZoom"
                            Class="action-btn zoom-btn" Title="@App.Localization!.Get("MoreList.ZoomInTitle")" OnClick="ZoomIn" />
                <div class="narrow-title">
                    <div class="btn-title-narrow">@App.Localization!.Get("MoreList.ZoomIn")</div>
                </div>
            </div>
        </div>

        @* 标签归属只看 ShowTabBar：横条不显示时，标签列表就在 MoreList 里 *@
        @if (AppState.CurrentPage == "home" && !AppState.ShowTabBar)
        {
            <div class="more-list-tabs">
                <div class="more-list-tabs-header">
                    <span class="more-list-tabs-title">@App.Localization!.Get("TabBar.Tabs")</span>
                    @if (AppState.CanAddTab)
                    {
                        <IconButton Size="IconButtonSize.Square28" Icon="add" IconSize="16"
                                    Title="@App.Localization!.Get("TabBar.NewTab")" OnClick="OnAddMoreTab" />
                    }
                </div>
                <div class="more-list-tabs-list">
                    @foreach (var tab in AppState.Tabs)
                    {
                        var isActive = tab.Id == AppState.ActiveTabId;
                        var tabId = tab.Id;
                        @* 同 TabBar 的标签项：形状留在这里，四态与键盘约定共用 .btn + KeyboardActivation *@
                        <div class="btn more-list-tabs-item @(isActive ? "is-selected" : "")"
                             role="button"
                             tabindex="0"
                             aria-current="@(isActive ? "true" : null)"
                             @onclick="() => OnMoreTabClick(tabId)"
                             @onkeydown="args => OnMoreTabKeyDownAsync(args, tabId)">
                            <span class="more-list-tabs-item-title">@GetMoreTabTitle(tab)</span>
                            @if (AppState.Tabs.Count > 1)
                            {
                                <IconButton Size="IconButtonSize.Square24" Icon="dismiss" IconSize="14"
                                            StopPropagation="true"
                                            Title="@App.Localization!.Get("TabBar.Close")"
                                            OnClick="() => OnMoreTabClose(tabId)" />
                            }
                        </div>
                    }
                </div>

            </div>
        }
    </div>

@code {
    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.Tabs) or nameof(AppState.ActiveTabId) or nameof(AppState.CurrentPage) or nameof(AppState.MoreListOpen) or nameof(AppState.IsPinned) or nameof(AppState.WikiZoom) or nameof(AppState.FloatingSearchOpen) or nameof(AppState.FloatingBarActive))
            _ = InvokeAsync(StateHasChanged);

        // 标签交还上方横条（ShowTabBar 变 true）时主动收起面板，避免两处同时可见
        if (e.PropertyName is nameof(AppState.IsSmallScreen) or nameof(AppState.IsShortScreen) or nameof(AppState.IsWindows) or nameof(AppState.IsMacFullScreen))
        {
            if (AppState.ShowTabBar)
                AppState.MoreListOpen = false;
            _ = InvokeAsync(StateHasChanged);
        }

        if (e.PropertyName == nameof(AppState.CurrentPage) && AppState.CurrentPage != "home")
            AppState.MoreListOpen = false;
    }

    private string GetMoreTabTitle(TabModel tab)
    {
        return string.IsNullOrWhiteSpace(tab.Title)
            ? AppState.ActiveWikiBook?.DefaultPageTitle ?? AppState.ActiveWikiBook?.Title ?? string.Empty
            : tab.Title;
    }

    /// <summary>
    /// 功能项按钮的尺寸：宽屏 = 高 36 + 图标 + 文字，窄屏 = 42×42 方块。
    /// 由 C# 判断而不是 CSS 断点，理由与"标签归属"一样：避免 CSS 与组件两套规则打架
    /// （见 OnAppStatePropertyChanged 里对 IsSmallScreen 的监听）。
    /// </summary>
    private IconButtonSize ActionsSize =>
        AppState.IsSmallScreen ? IconButtonSize.Square42 : IconButtonSize.Wide36;

    /// <summary>键盘激活（Enter / Space）与点击同路；判定规则只在 KeyboardActivation 里一份。</summary>
    private Task OnMoreTabKeyDownAsync(KeyboardEventArgs args, string tabId) =>
        KeyboardActivation.InvokeIfActivateKey(args, () => OnMoreTabClick(tabId));

    private void CloseMoreList()
    {
        AppState.MoreListOpen = false;
    }
    private void FindInPage()
    {
        AppState.MoreListOpen = false;
        AppState.FindInPageOpen = true;
    }
    /// <summary>
    /// 切换标签后保持面板打开，方便连续切换/关闭（关闭只由遮罩点击或切走页面触发）。
    /// </summary>
    private async Task OnMoreTabClick(string tabId)
    {
        if (tabId != AppState.ActiveTabId)
            await AppService.SwitchToTabAsync(tabId);
    }

    private async Task OnMoreTabClose(string tabId)
    {
        await AppService.CloseTabAsync(tabId);
    }

    private async Task OnAddMoreTab()
    {
        var tab = await AppService.AddTabAsync();
        await AppService.SwitchToTabAsync(tab.Id);
    }

    private void TogglePinStateAsync()
    {
        var isPinned = !AppState.IsPinned;
        WindowHelper.SetAlwaysOnTop(isPinned);
        AppState.IsPinned = isPinned;
    }

    // ===== 悬浮窗（仅 Windows）=====
    // 开启后主窗口隐藏、桌面上只剩一个图标球；点球则主窗口以"小条"形态出现。
    // 小条形态下主窗口是显示的，所以这个按钮可以作为"球 ↔ 小条"的切换入口。
    private void ToggleFloatingSearch()
    {
        bool isOpen;
        bool barActive;
#if WINDOWS
        if (FloatingWindow.IsBarActive)
        {
            // 已经在小条形态：收起来，回到图标球
            FloatingWindow.CollapseBar();
            isOpen = true;
            barActive = false;
        }
        else if (FloatingWindow.IsOpen)
        {
            // 只有球（此时主窗口被隐藏，正常点不到这里）
            FloatingWindow.ExpandBar();
            isOpen = true;
            barActive = true;
        }
        else
        {
            isOpen = FloatingWindow.Open();
            barActive = false;
        }
#else
        isOpen = false;
        barActive = false;
#endif
        AppState.FloatingSearchOpen = isOpen;
        AppState.FloatingBarActive = barActive;
        CloseMoreList();
    }

    // ===== 缩放：宽裕（IsLargeScreen）时一行「缩放 | 百分比 | + | −」，窄屏（IsSmallScreen）只留两个放大镜按钮 =====
    private bool IsMaxZoom => AppState.WikiZoom >= AppState.MaxWikiZoom;

    private bool IsMinZoom => AppState.WikiZoom <= AppState.MinWikiZoom;

    private void ZoomIn() => AppState.WikiZoom += AppState.WikiZoomStep;

    private void ZoomOut() => AppState.WikiZoom -= AppState.WikiZoomStep;

    private void ResetZoom() => AppState.WikiZoom = 100;
}
