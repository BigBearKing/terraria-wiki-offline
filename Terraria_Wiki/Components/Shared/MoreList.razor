@using System.ComponentModel

@if (AppState.MoreListOpen)
{
    <Mask Show="true" Transparent="true" ZIndex="1002" BackPriority="1004" OnClick="CloseMoreList" />
    <div class="more-list" data-tauri-drag-region>
        <div class="more-list-actions">
            <button class="action-btn button" title="@App.Localization!.Get("Common.FindInPage")" @onclick="FindInPage">
                <Icon Name="text-search" Size="20"></Icon>
                <div class="btn-title">@App.Localization!.Get("Common.FindInPage")</div>
            </button>
            @if (AppState.IsWindows || AppState.IsMacCatalyst)
            {
                <button class="action-btn button" title="@App.Localization!.Get("TopBar.PinToTop")" style="@(AppState.IsPinned ? "color:var(--blue-primary)" : "")" @onclick="TogglePinStateAsync">
                    <Icon Name="@(AppState.IsPinned ? "pin-filled" : "pin")" Size="20"></Icon>
                    <div class="btn-title">@App.Localization!.Get("TopBar.PinToTop")</div>
                </button>
            }
        </div>

        @if (AppState.CurrentPage == "home")
        {
            <div class="more-list-tabs">
                <div class="more-list-tabs-header">
                    <span class="more-list-tabs-title">@App.Localization!.Get("TabBar.Tabs")</span>
                    @if (AppState.CanAddTab)
                    {
                        <button class="more-list-tabs-add action-btn" @onclick="OnAddMoreTab" title="@App.Localization!.Get("TabBar.NewTab")">
                            <Icon Name="add" Size="16"></Icon>
                        </button>
                    }
                </div>
                <div class="more-list-tabs-list">
                    @foreach (var tab in AppState.Tabs)
                    {
                        var isActive = tab.Id == AppState.ActiveTabId;
                        var tabId = tab.Id;
                        <div class="more-list-tabs-item @(isActive ? "active" : "")" @onclick="() => OnMoreTabClick(tabId)">
                            <span class="more-list-tabs-item-title">@GetMoreTabTitle(tab)</span>
                            @if (AppState.Tabs.Count > 1)
                            {
                                <button class="more-list-tabs-item-close" @onclick="() => OnMoreTabClose(tabId)" @onclick:stopPropagation="true" title="@App.Localization!.Get("TabBar.Close")">
                                    <Icon Name="dismiss" Size="14"></Icon>
                                </button>
                            }
                        </div>
                    }
                </div>

            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        AppState.PropertyChanged += OnAppStatePropertyChanged;
    }

    public void Dispose()
    {
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is nameof(AppState.Tabs) or nameof(AppState.ActiveTabId) or nameof(AppState.CurrentPage) or nameof(AppState.MoreListOpen) or nameof(AppState.IsPinned))
            _ = InvokeAsync(StateHasChanged);

        if (e.PropertyName == nameof(AppState.CurrentPage) && AppState.CurrentPage != "home")
            AppState.MoreListOpen = false;
    }

    private string GetMoreTabTitle(TabModel tab)
    {
        return string.IsNullOrWhiteSpace(tab.Title)
            ? AppState.ActiveWikiBook?.DefaultPageTitle ?? AppState.ActiveWikiBook?.Title ?? string.Empty
            : tab.Title;
    }

    private void CloseMoreList()
    {
        AppState.MoreListOpen = false;
    }
    private void FindInPage()
    {
        AppState.MoreListOpen = false;
        AppState.FindInPageOpen = true;
    }
    private async Task OnMoreTabClick(string tabId)
    {
        if (tabId != AppState.ActiveTabId)
            await AppService.SwitchToTabAsync(tabId);
        CloseMoreList();
    }

    private async Task OnMoreTabClose(string tabId)
    {
        await AppService.CloseTabAsync(tabId);
    }

    private async Task OnAddMoreTab()
    {
        var tab = await AppService.AddTabAsync();
        await AppService.SwitchToTabAsync(tab.Id);
    }

    private void TogglePinStateAsync()
    {
        var isPinned = !AppState.IsPinned;
        WindowHelper.SetAlwaysOnTop(isPinned);
        AppState.IsPinned = isPinned;
    }
}
