@* 统一遮罩层组件：半透明/透明遮罩、淡入淡出、点击关闭（或放行点击） *@
@implements IDisposable
<div class="app-mask @(Show ? "show" : "") @(Locked ? "locked" : "") @(Transparent ? "transparent" : "") @(FromHeader ? "from-header" : "") @(NarrowOnly ? "narrow-only" : "")"
     style="z-index: @ZIndex;"
     @onclick="OnClick"
     @onpointerdown="OnPointerDown"
     @ontouchmove="OnTouchMove"
     @onwheel="OnWheel"></div>

@code {
    /// <summary>是否显示（淡入 + 拦截点击）</summary>
    [Parameter] public bool Show { get; set; }

    /// <summary>锁定：即使显示也放行点击（pointer-events: none），如搜索进行中</summary>
    [Parameter] public bool Locked { get; set; }

    /// <summary>透明遮罩：无背景色，仅拦截点击</summary>
    [Parameter] public bool Transparent { get; set; }

    /// <summary>从顶部栏下方开始覆盖（top: var(--header-height)）</summary>
    [Parameter] public bool FromHeader { get; set; }

    /// <summary>
    /// 仅在窄屏显示（宽 ≤768，等价 AppState.IsSmallScreen）；又宽又高、以及"宽而矮"都不显示。
    /// 用于侧边栏抽屉这类"只有窄屏才浮在内容之上、需要点空白处关闭"的场景，对应 .narrow-only。
    /// 注意不要与 IsMobile（平台）混淆。
    /// </summary>
    [Parameter] public bool NarrowOnly { get; set; }

    /// <summary>层级（默认 900）</summary>
    [Parameter] public int ZIndex { get; set; } = 900;

    /// <summary>返回键层级；未指定时使用遮罩层级。</summary>
    [Parameter] public int? BackPriority { get; set; }

    /// <summary>点击遮罩时回调（用于关闭对应面板）</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>指针按下时回调。</summary>
    [Parameter] public EventCallback<PointerEventArgs> OnPointerDown { get; set; }

    /// <summary>触摸滑动时回调。</summary>
    [Parameter] public EventCallback<TouchEventArgs> OnTouchMove { get; set; }

    /// <summary>滚轮滚动时回调。</summary>
    [Parameter] public EventCallback<WheelEventArgs> OnWheel { get; set; }

    private readonly Guid _backLayerId = Guid.NewGuid();

    protected override void OnParametersSet()
    {
        if (Show && !Locked)
        {
            BackLayerCoordinator.Register(
                _backLayerId,
                BackPriority ?? ZIndex,
                () => _ = OnClick.InvokeAsync());
        }
        else
        {
            BackLayerCoordinator.Unregister(_backLayerId);
        }
    }

    public void Dispose() => BackLayerCoordinator.Unregister(_backLayerId);
}
