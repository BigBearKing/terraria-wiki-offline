@using System.ComponentModel
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@using Terraria_Wiki.Services
@using Terraria_Wiki.Models

@if (!string.IsNullOrWhiteSpace(query))
{
	<Mask Show="true" Locked="isSearching" Transparent="true" FromHeader="true" ZIndex="998" BackPriority="1002" OnClick="ClosePanel" />

	<div class="search-popup-panel">
		@if (isSearching)
		{
			<div class="search-status">@Loc.Get("SearchResultPanel.Searching")</div>
		}
		else if (results != null && results.Count == 0)
		{
			<div class="search-status">@Loc.Get("SearchResultPanel.NotFound", query)</div>
		}
		else if (results != null)
		{
			<ul class="result-list">
				@foreach (var item in results)
				{
					<li class="result-item" @onclick="() => SelectResult(string.IsNullOrEmpty(item.RedirectTo) ? item.Title : item.RedirectTo)">
						<div class="result-title">
							@HighlightMatches(item.Title)
							@if (!string.IsNullOrEmpty(item.RedirectTo))
							{
								<span style="color: var(--text-secondary); font-size: 0.8em; margin-left: 12px;">
									➔ @Loc.Get("SearchResultPanel.RedirectTo"): @HighlightMatches(item.RedirectTo)
								</span>
							}
						</div>

						<div class="result-snippet">
							@((MarkupString)item.Snippet)
						</div>
					</li>
				}
			</ul>
		}
	</div>
}

@code {
	private string query = "";
	protected override void OnInitialized()
	{
		//订阅 Topbar 传来的搜索事件
		AppState.PropertyChanged += OnAppStatePropertyChanged;
		Loc.OnChange += StateHasChanged;
	}

	public void Dispose()
	{
		AppState.PropertyChanged -= OnAppStatePropertyChanged;
		// 这次订阅原先没有解绑：面板是"一开就 new、清空就 Dispose"的，
		// 每轮搜索都漏一份，累积后同一次渲染会被触发多次 StateHasChanged。
		Loc.OnChange -= StateHasChanged;
	}

	private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
	{
		if (e.PropertyName == nameof(AppState.SearchQuery))
			HandleSearchChanged();
	}

	// 当用户点击某一个搜索结果时，向 Topbar 触发事件
	[Parameter]
	public EventCallback<string> OnResultSelected { get; set; }

	// 当用户点击遮罩层（空白处）时，通知 Topbar 清空搜索词或关闭面板
	[Parameter]
	public EventCallback OnCloseRequested { get; set; }

	private bool isSearching = false;
	private List<SearchResultItem>? results;

	/// <summary>
	/// 查询序号：每发起一次搜索自增，回来时只有"最新的那一次"才允许写 results。
	/// 防抖只保证"少发查询"，不保证"按序返回"——慢查询后到会把新查询的结果覆盖掉，
	/// 表现为列表先对了又跳回旧结果。这里用序号把过期结果直接丢弃。
	/// </summary>
	private int _searchVersion;

	private async void HandleSearchChanged()
	{
		query = AppState.SearchQuery?.Trim();
		if (string.IsNullOrWhiteSpace(query))
		{
			// 清空输入：作废在途查询，避免它的结果回来后把空面板又填上
			_searchVersion++;
			isSearching = false;
			results = null;
			StateHasChanged();
			return;
		}
		await ExecuteSearchAsync(query);
	}

	private async Task ExecuteSearchAsync(string searchTerm)
	{
		var version = ++_searchVersion;

		isSearching = true;
		StateHasChanged();

		try
		{
			var fetched = await App.ContentDb.SearchAsync(searchTerm);

			// 期间又输入了新词（或输入被清空）→ 这次结果已过期，直接丢弃
			if (version != _searchVersion)
				return;

			results = fetched;
		}
		finally
		{
			// 只有最新一次查询才有资格收尾，否则会把新查询的 loading 态提前关掉
			if (version == _searchVersion)
			{
				isSearching = false;
				StateHasChanged();
			}
		}
	}

	private MarkupString HighlightMatches(string? text)
	{
		if (string.IsNullOrEmpty(text))
			return new MarkupString(string.Empty);

		var terms = query
			.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.OrderByDescending(term => term.Length)
			.Select(Regex.Escape)
			.ToArray();

		if (terms.Length == 0)
			return new MarkupString(HtmlEncoder.Default.Encode(text));

		var pattern = string.Join("|", terms);
		var result = Regex.Replace(
			text,
			pattern,
			match => $"<mark class=\"search-highlight\">{HtmlEncoder.Default.Encode(match.Value)}</mark>",
			RegexOptions.IgnoreCase | RegexOptions.CultureInvariant);

		var encodedParts = Regex.Split(result, "(<mark class=\\\"search-highlight\\\">.*?</mark>)", RegexOptions.Singleline);
		for (var i = 0; i < encodedParts.Length; i++)
		{
			if (!encodedParts[i].StartsWith("<mark class=\"search-highlight\">", StringComparison.Ordinal))
				encodedParts[i] = HtmlEncoder.Default.Encode(encodedParts[i]);
		}

		return new MarkupString(string.Concat(encodedParts));
	}

	private async Task SelectResult(string title)
	{
		// 触发事件，把被点击的标题传给 Topbar
		await OnResultSelected.InvokeAsync(title);
	}

	private async Task ClosePanel()
	{
		if (isSearching)
		{
			return;
		}
		await OnCloseRequested.InvokeAsync();
	}
}