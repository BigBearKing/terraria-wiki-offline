@* 纯文本面板：等宽 / 可折行 / 可选中复制，另外带"加载中""未找到"两种占位。
   「设置 → 关于 → 开源许可」的详情页与「设置 → 数据 → 第三方网盘资源」共用这一个组件，
   两边的正文都不需要富文本，只是纯文本。

   根元素带 .list-container 是必须的：标题头随滚动 1:1 收起（index.html 按这个类找滚动容器）、
   `.page-header + .list-container` 的 -52px 上边距、以及滚动条样式都挂在它上面。
   组件渲染出来就是 .page-header 的下一个兄弟节点，所以那套相邻选择器照旧生效。 *@

<div class="list-container text-panel">
    @if (Loading)
    {
        <div class="text-panel-empty">@LoadingText</div>
    }
    else if (Content is null)
    {
        <div class="text-panel-empty">@EmptyText</div>
    }
    else
    {
        <pre class="text-panel-body">@Content</pre>
    }
</div>

@code {
    /// <summary>正文。为 null 且 <see cref="Loading"/> 为 false 时显示 <see cref="EmptyText"/>。</summary>
    [Parameter]
    public string? Content { get; set; }

    /// <summary>正在读取：显示 <see cref="LoadingText"/>，此时 <see cref="Content"/> 不参与渲染。</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>"正在读取……"的文案；本地化由调用方做，组件不碰 Loc。</summary>
    [Parameter]
    public string? LoadingText { get; set; }

    /// <summary>"未找到 / 获取失败"的文案。</summary>
    [Parameter]
    public string? EmptyText { get; set; }
}
