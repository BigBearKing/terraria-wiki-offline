@using System.ComponentModel
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.Maui.ApplicationModel.DataTransfer
@using Terraria_Wiki.Services
@inject IJSRuntime JSRuntime
@implements IDisposable

<div id="log-panel" class="log-panel @(AppState.SidebarIsExpanded ? "expanded" : "collapsed")">
    <div class="drag-handle-container">
        <div class="drag-handle"></div>
    </div>
    
    <div class="log-header">

        <div class="left-group">
            <span class="log-title">@Loc.Get("Common.Log")</span>
            <span class="log-info" title="@GetCurrentTaskText()">@GetCurrentTaskText()</span>
        </div>

        <IconButton Size="IconButtonSize.Square32" Icon="dismiss" IconSize="22"
                    Class="close-btn" Title="@Loc.Get("Common.Close")"
                    OnClick="CloseLogPanel" />
    </div>
    <div id="log-container" class="log-container no-swipe">
        @* AnchorMode.End（.NET 11 新增）：把视口钉在列表末尾。
           不设它的时候，Virtualize 只在"用户自己滚动"把占位块滚进视口时才继续取下一段；
           而我们是用 scrollTop 以程序方式贴底的，占位块一直可见、可见比例也不变，
           交叉观察不会报变化 —— 于是新日志只把占位块（空行）撑高、滚动跟着下去，
           一行文字都不会取。手指一滑触发了真正的滚动，它才把那段数据取上来。
           设成 End 之后，框架每次渲染后自己判断"是不是在底部"，在底部就置为
           从底部填充视口（convergence）并主动取数；用户往上翻则自动解除，不再拽回来。 *@
        <Virtualize @ref="_virtualize"
                    ItemsProvider="LoadLogs"
                    Context="item"
                    OverscanCount="20"
                    AnchorMode="VirtualizeAnchorMode.End">
            @{
                var parsedLog = ParseLogLine(item.Raw);
            }
            @* 一行一条（nowrap + 省略号），看全长有三种办法：
                 · 桌面：鼠标悬停 → 原生 title 提示（原始整行，含时间戳与级别标签）
                 · 点一下 → 这一行展开折行显示，再点收起
                 · 长按 0.5 秒 → 复制整行到剪贴板（手机、桌面都行） *@
            <div class="log-line @parsedLog.CssClass @(_expanded.Contains(item.Index) ? "expanded" : "")"
                 title="@item.Raw"
                 @onpointerdown="() => OnLinePointerDown(item)"
                 @onpointerup="CancelLongPress"
                 @onpointerleave="CancelLongPress"
                 @onpointercancel="CancelLongPress"
                 @oncontextmenu="() => { }"
                 @oncontextmenu:preventDefault="true"
                 @onclick="() => ToggleExpand(item.Index)">@parsedLog.Text</div>
        </Virtualize>
    </div>

    @* 复制成功的小提示（1.5 秒后自动消失）：组件见 Components/Controls/Toast.razor，
       窄屏缩放按钮也用它，所以定位由本面板当定位祖先（.log-panel 是 fixed）。 *@
    <Toast @ref="_toast" />
</div>

@code {

    private Virtualize<LogItem> _virtualize;
    private readonly Guid _backLayerId = Guid.NewGuid();

    /// <summary>已展开折行的日志行（按它在整个日志里的序号记；Virtualize 回收项也不受影响）。</summary>
    private readonly HashSet<int> _expanded = new();

    /// <summary>日志行 + 它在整个日志里的序号。</summary>
    private sealed record LogItem(int Index, string Raw);

    private bool _isAutoScrolling = false; // 防止重入

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        App.LogManager.OnLogAdded += RefreshLog;
    }

    protected override void OnParametersSet()
    {
        if (AppState.LogPanelIsOpen)
        {
            BackLayerCoordinator.Register(
                _backLayerId,
                1003,
                () => App.AppStateManager.LogPanelIsOpen = false);
        }
        else
        {
            BackLayerCoordinator.Unregister(_backLayerId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {


            await Task.Delay(30);

            await JSRuntime.InvokeVoidAsync("scrollToBottomImmediate", "log-container");

            await JSRuntime.InvokeVoidAsync("setupResponsiveSwipe", "log-panel");


        }
    }

    private async ValueTask<ItemsProviderResult<LogItem>> LoadLogs(ItemsProviderRequest req)
    {
        var total = App.LogManager.GetTotalCount();
        // 这里读取的永远是当前 _activeLogPath 的内容
        var lines = await App.LogManager.GetLogsAsync(req.StartIndex, req.Count);

        var items = new List<LogItem>(req.Count);
        int index = req.StartIndex;
        foreach (var line in lines)
            items.Add(new LogItem(index++, line));

        return new ItemsProviderResult<LogItem>(items, total);
    }

    /// <summary>点一下展开/收起这一行：手机端没有 hover，靠它看全长内容。</summary>
    private void ToggleExpand(int index)
    {
        // 长按刚复制过：这一次抬手不再当点击（否则复制完还会顺手展开）
        if (_longPressHandled)
        {
            _longPressHandled = false;
            return;
        }

        if (!_expanded.Add(index))
            _expanded.Remove(index);

        StateHasChanged();
    }

    private const int LongPressMs = 500;

    private CancellationTokenSource? _longPressCts;
    private bool _longPressHandled;

    /// <summary>"已复制"轻提示（Components/Controls/Toast.razor）。</summary>
    private Toast? _toast;

    /// <summary>手指/鼠标按下：起一个 0.5 秒计时；到点还没松开就算长按 → 复制整行。</summary>
    private void OnLinePointerDown(LogItem item)
    {
        _longPressHandled = false;      // 每次按下先清掉上一次的抑制标记

        _longPressCts?.Cancel();
        _longPressCts?.Dispose();
        var cts = new CancellationTokenSource();
        _longPressCts = cts;

        _ = LongPressAsync(item, cts.Token);
    }

    private async Task LongPressAsync(LogItem item, CancellationToken token)
    {
        try
        {
            await Task.Delay(LongPressMs, token);
        }
        catch (TaskCanceledException)
        {
            return;                     // 提前松手/移开 → 当普通点击处理
        }

        if (token.IsCancellationRequested)
            return;

        _longPressHandled = true;
        await CopyLineAsync(item.Raw);
    }

    /// <summary>松开/移开/取消：撤销还没到点的长按计时。</summary>
    private void CancelLongPress()
    {
        _longPressCts?.Cancel();
        _longPressCts?.Dispose();
        _longPressCts = null;
    }

    /// <summary>复制整行到剪贴板，并浮一个"已复制"的提示（1.5 秒后自动消失）。</summary>
    private async Task CopyLineAsync(string text)
    {
        try
        {
            await Clipboard.Default.SetTextAsync(text);

            if (_toast is not null)
                await _toast.ShowAsync(Loc.Get("LogPanel.Copied"));
        }
        catch (Exception ex)
        {
            App.LogManager?.Error($"Copy log line failed: {ex}");
        }
    }

    private async void RefreshLog()
    {
        // 如果正在处理中，跳过
        if (_isAutoScrolling) return;
        _isAutoScrolling = true;

        await InvokeAsync(async () =>
        {
            // 1. 告诉 Virtualize 数据变了
            if (_virtualize != null)
            {
                await _virtualize.RefreshDataAsync();
            }
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("scrollToBottom", "log-container");
        });
        _isAutoScrolling = false;
    }

    /// <summary>标题右侧"当前任务"的文本（没有任务时为空串）；标题栏也会截断，所以顺带给它做 tooltip。</summary>
    private string GetCurrentTaskText()
        => AppState.HasActiveTasks
            ? Loc.Get("LogPanel.CurrentTask") + string.Join(", ", AppState.ActiveTasks.Select(x => AppState.Tasks[x.Task.TaskType].GetName(Loc)))
            : "";

    // 新增：解析日志类型，去掉标签并分配对应的 CSS 类名
    private (string Text, string CssClass) ParseLogLine(string log)
    {
        if (string.IsNullOrWhiteSpace(log)) return (log, "");

        if (log.Contains("[ERROR]"))
        {
            return (log.Replace("[ERROR]", "").Trim(), "type-error");
        }
        else if (log.Contains("[SUCCESS]"))
        {
            return (log.Replace("[SUCCESS]", "").Trim(), "type-success");
        }
        else if (log.Contains("[INFO]"))
        {
            return (log.Replace("[INFO]", "").Trim(), "");
        }

        return (log, "");
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // 只关心任务状态变化（更新 "处理中" 文本和任务名称）
        if (e.PropertyName == nameof(AppState.ActiveTasks))
            StateHasChanged();
    }

    [JSInvokable]
    public static void CloseLogPanel()
    {
        App.AppStateManager?.LogPanelIsOpen = false;
    }

    public void Dispose()
    {
        BackLayerCoordinator.Unregister(_backLayerId);
        _ = JSRuntime.InvokeVoidAsync("swipeManagers.log-panel.dispose");
        App.LogManager.OnLogAdded -= RefreshLog;
        AppState.PropertyChanged -= OnAppStatePropertyChanged;

        _longPressCts?.Cancel();
        _longPressCts?.Dispose();
    }
}
