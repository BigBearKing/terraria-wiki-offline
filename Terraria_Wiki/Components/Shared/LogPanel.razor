@using System.ComponentModel
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Terraria_Wiki.Services
@inject IJSRuntime JSRuntime
@implements IDisposable

<div id="log-panel" class="log-panel @(AppState.SidebarIsExpanded ? "expanded" : "collapsed")">
    <div class="drag-handle-container">
        <div class="drag-handle"></div>
    </div>
    
    <div class="log-header">

        <div class="left-group">
            <span class="log-title">@Loc.Get("Common.Log")</span>
            <span class="log-info">@(AppState.HasActiveTasks ? Loc.Get("LogPanel.CurrentTask") + string.Join(", ", AppState.ActiveTasks.Select(x => AppState.Tasks[x.Task.TaskType].GetName(Loc))) : "")</span>
        </div>

        <div class="close-btn button" @onclick="CloseLogPanel">
            <Icon Name="dismiss" />
        </div>
    </div>
    <div id="log-container" class="log-container no-swipe">
        <Virtualize @ref="_virtualize"
                    ItemsProvider="LoadLogs"
                    Context="log"
                    OverscanCount="20">
            @{
                var parsedLog = ParseLogLine(log);
            }
            <div class="log-line @parsedLog.CssClass">@parsedLog.Text</div>
        </Virtualize>
    </div>
</div>

@code {

    private Virtualize<string> _virtualize;
    private readonly Guid _backLayerId = Guid.NewGuid();

    private bool _isAutoScrolling = false; // 防止重入

    protected override void OnInitialized()
    {
        base.OnInitialized();
        AppState.PropertyChanged += OnAppStatePropertyChanged;
        App.LogManager.OnLogAdded += RefreshLog;
    }

    protected override void OnParametersSet()
    {
        if (AppState.LogPanelIsOpen)
        {
            BackLayerCoordinator.Register(
                _backLayerId,
                1003,
                () => App.AppStateManager.LogPanelIsOpen = false);
        }
        else
        {
            BackLayerCoordinator.Unregister(_backLayerId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {


            await Task.Delay(30);

            await JSRuntime.InvokeVoidAsync("scrollToBottomImmediate", "log-container");

            await JSRuntime.InvokeVoidAsync("setupResponsiveSwipe", "log-panel");


        }
    }

    private async ValueTask<ItemsProviderResult<string>> LoadLogs(ItemsProviderRequest req)
    {
        var total = App.LogManager.GetTotalCount();
        // 这里读取的永远是当前 _activeLogPath 的内容
        var items = await App.LogManager.GetLogsAsync(req.StartIndex, req.Count);
        return new ItemsProviderResult<string>(items, total);
    }

    private async void RefreshLog()
    {
        // 如果正在处理中，跳过
        if (_isAutoScrolling) return;
        _isAutoScrolling = true;

        await InvokeAsync(async () =>
        {
            // 1. 告诉 Virtualize 数据变了
            if (_virtualize != null)
            {
                await _virtualize.RefreshDataAsync();
            }
            StateHasChanged();

            await JSRuntime.InvokeVoidAsync("scrollToBottom", "log-container");
        });
        _isAutoScrolling = false;
    }

    // 新增：解析日志类型，去掉标签并分配对应的 CSS 类名
    private (string Text, string CssClass) ParseLogLine(string log)
    {
        if (string.IsNullOrWhiteSpace(log)) return (log, "");

        if (log.Contains("[ERROR]"))
        {
            return (log.Replace("[ERROR]", "").Trim(), "type-error");
        }
        else if (log.Contains("[SUCCESS]"))
        {
            return (log.Replace("[SUCCESS]", "").Trim(), "type-success");
        }
        else if (log.Contains("[INFO]"))
        {
            return (log.Replace("[INFO]", "").Trim(), "");
        }

        return (log, "");
    }

    private void OnAppStatePropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        // 只关心任务状态变化（更新 "处理中" 文本和任务名称）
        if (e.PropertyName == nameof(AppState.ActiveTasks))
            StateHasChanged();
    }

    [JSInvokable]
    public static void CloseLogPanel()
    {
        App.AppStateManager?.LogPanelIsOpen = false;
    }

    public void Dispose()
    {
        BackLayerCoordinator.Unregister(_backLayerId);
        _ = JSRuntime.InvokeVoidAsync("swipeManagers.log-panel.dispose");
        App.LogManager.OnLogAdded -= RefreshLog;
        AppState.PropertyChanged -= OnAppStatePropertyChanged;
    }
}
